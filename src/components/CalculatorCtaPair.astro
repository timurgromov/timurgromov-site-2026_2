---
import {
  expertCtaSource,
  maxCalculatorUrlFor,
  telegramCalculatorUrlFor,
  type ExpertCtaPlacement,
} from "../site/home-data";
import { corporateSplitCtaLink } from "../site/corporate-split-cta";

interface Props {
  placement: Extract<ExpertCtaPlacement, "hero" | "mid_article" | "final">;
  theme?: "dark" | "light";
}

const { placement, theme = "light" } = Astro.props;
const source = expertCtaSource("calculator", "wedding_budget", placement);
const attrs = `target="_blank" rel="noopener noreferrer nofollow" data-calculator-source="${source}"`;
---

<div
  class={`calculator-cta-pair calculator-cta-pair--${theme}`}
  data-testid={`calculator-cta-${placement}`}
  aria-label="Рассчитать бюджет свадьбы"
>
  <Fragment set:html={corporateSplitCtaLink("calculator-cta-pair__button calculator-cta-pair__button--primary", telegramCalculatorUrlFor("wedding_budget", placement), "Рассчитать в Telegram", attrs)} />
  <Fragment set:html={corporateSplitCtaLink("calculator-cta-pair__button calculator-cta-pair__button--secondary", maxCalculatorUrlFor("wedding_budget", placement), "Рассчитать в MAX", attrs)} />
</div>

<style>
  .calculator-cta-pair {
    --t-text-font: "Manrope", Arial, sans-serif;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    width: min(100%, 590px);
  }

  .calculator-cta-pair :global(.tg-split-cta) {
    --tg-cta-height: 42px;
    --tg-cta-arrow-box: 42px;
    --tg-cta-overlap: 1px;
    --tg-cta-pad-left: 20px;
    --tg-cta-pad-right: 18px;
    --tg-cta-radius: 5px;
    --tg-cta-fill: #fffefa;
    --tg-cta-border: #fa4604;
    --tg-cta-color: #241d19;
    --tg-cta-arrow-fill: #fffefa;
    --tg-cta-arrow-color: #241d19;
    --tg-cta-icon-size: 13px;
    --tg-cta-font-size: 13px;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(var(--tg-cta-arrow-box) - var(--tg-cta-overlap));
    align-items: stretch;
    width: 100%;
    height: var(--tg-cta-height) !important;
    min-height: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-sizing: border-box;
    background: transparent !important;
    color: var(--tg-cta-color) !important;
    font-family: var(--t-text-font);
    font-size: var(--tg-cta-font-size) !important;
    font-weight: 400;
    line-height: 1;
    text-decoration: none !important;
    transition: box-shadow .18s ease, transform .18s ease;
  }

  .calculator-cta-pair :global(.tg-split-cta__plate),
  .calculator-cta-pair :global(.tg-split-cta__arrow-box) {
    grid-row: 1;
    border: 1px solid var(--tg-cta-border);
    box-sizing: border-box;
    background: var(--tg-cta-fill);
    transition: background-color .18s ease, border-color .18s ease;
  }

  .calculator-cta-pair :global(.tg-split-cta__plate) {
    grid-column: 1;
    min-width: 0;
    border-radius: var(--tg-cta-radius);
  }

  .calculator-cta-pair :global(.tg-split-cta__arrow-box) {
    grid-column: 2;
    width: var(--tg-cta-arrow-box);
    margin-left: calc(-1 * var(--tg-cta-overlap));
    border-radius: var(--tg-cta-radius);
    background: var(--tg-cta-arrow-fill);
  }

  .calculator-cta-pair :global(.tg-split-cta__label) {
    z-index: 1;
    grid-column: 1;
    grid-row: 1;
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0 var(--tg-cta-pad-right) 0 var(--tg-cta-pad-left);
    color: var(--tg-cta-color);
    font: inherit;
    white-space: nowrap;
    pointer-events: none;
  }

  .calculator-cta-pair :global(.tg-split-cta__icon) {
    z-index: 1;
    grid-column: 2;
    grid-row: 1;
    display: grid;
    width: var(--tg-cta-arrow-box);
    margin-left: calc(-1 * var(--tg-cta-overlap));
    place-items: center;
    pointer-events: none;
  }

  .calculator-cta-pair :global(.tg-split-cta__icon)::before {
    width: var(--tg-cta-icon-size);
    height: var(--tg-cta-icon-size);
    background: var(--tg-cta-arrow-color);
    content: "";
    -webkit-mask: url("/images/split-arrow-up-right.svg") center / contain no-repeat;
    mask: url("/images/split-arrow-up-right.svg") center / contain no-repeat;
    transition: transform .2s ease, background-color .18s ease;
  }

  .calculator-cta-pair :global(.calculator-cta-pair__button--primary) {
    --tg-cta-fill: #fa4604;
    --tg-cta-color: #fffefa;
    --tg-cta-arrow-fill: #fa4604;
    --tg-cta-arrow-color: #fffefa;
  }

  .calculator-cta-pair--dark :global(.calculator-cta-pair__button--secondary) {
    --tg-cta-fill: rgba(31, 25, 22, .58);
    --tg-cta-color: #fffefa;
    --tg-cta-arrow-fill: rgba(31, 25, 22, .58);
    --tg-cta-arrow-color: #fffefa;
  }

  @media (hover: hover) {
    .calculator-cta-pair :global(.tg-split-cta:hover) {
      --tg-cta-fill: #fa4604;
      --tg-cta-color: #fffefa;
      --tg-cta-arrow-fill: #fa4604;
      --tg-cta-arrow-color: #fffefa;
      box-shadow: 0 14px 28px rgba(250, 70, 4, .16);
      transform: translateY(-1px);
    }

    .calculator-cta-pair :global(.tg-split-cta:hover .tg-split-cta__icon)::before {
      transform: rotate(45deg);
    }
  }

  @media (min-width: 1200px) {
    .calculator-cta-pair :global(.tg-split-cta) {
      --tg-cta-height: clamp(42px, 2.5vw, 48px);
      --tg-cta-arrow-box: clamp(42px, 2.5vw, 48px);
      --tg-cta-pad-left: clamp(20px, 1.6667vw, 34px);
      --tg-cta-pad-right: clamp(18px, 1.5vw, 26px);
      --tg-cta-radius: clamp(5px, .4167vw, 8px);
      --tg-cta-icon-size: clamp(10px, .8333vw, 16px);
      --tg-cta-font-size: clamp(12px, 1vw, 19px);
    }
  }

  @media (min-width: 1920px) {
    .calculator-cta-pair :global(.tg-split-cta) {
      --tg-cta-height: 48px;
      --tg-cta-arrow-box: 48px;
      --tg-cta-pad-left: 34px;
      --tg-cta-pad-right: 26px;
      --tg-cta-radius: 8px;
      --tg-cta-icon-size: 16px;
      --tg-cta-font-size: 19px;
    }
  }

  @media (max-width: 1199px) {
    .calculator-cta-pair :global(.tg-split-cta) {
      --tg-cta-height: 42px;
      --tg-cta-arrow-box: 42px;
      --tg-cta-pad-left: 18px;
      --tg-cta-pad-right: 16px;
      --tg-cta-radius: 5px;
      --tg-cta-icon-size: 13px;
      --tg-cta-font-size: 13px;
    }
  }

  @media (max-width: 479px) {
    .calculator-cta-pair {
      grid-template-columns: 1fr;
    }

    .calculator-cta-pair :global(.tg-split-cta) {
      --tg-cta-height: 48px;
      --tg-cta-arrow-box: 48px;
      --tg-cta-font-size: 13px;
    }
  }
</style>
