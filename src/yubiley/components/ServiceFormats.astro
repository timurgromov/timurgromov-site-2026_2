---
const rubles = (value: number) => `${new Intl.NumberFormat('ru-RU').format(value)} ₽`;

const formats = [
  {
    name: 'Камерный',
    title: 'Ведущий + DJ',
    note: 'Программа до 5 часов',
    price: 135_000,
    extension: 20_000,
    items: ['Подготовка программы', 'Ведение юбилея', 'DJ и музыкальное сопровождение']
  },
  {
    name: 'Праздничный',
    title: 'Ведущий + DJ',
    note: 'Программа до 6 часов',
    price: 155_000,
    extension: 25_000,
    items: ['Подготовка программы', 'Ведение юбилея', 'DJ и музыкальное сопровождение', 'Расширенный тайминг до 6 часов']
  },
  {
    name: 'С кавер-группой',
    title: 'Ведущий + DJ + кавер-группа',
    note: 'Кавер-группа в смете — от 160 000 ₽',
    price: 315_000,
    extension: 25_000,
    detailsHref: '#music-program',
    items: [
      'Подготовка программы',
      'Ведение юбилея',
      'DJ и музыкальное сопровождение',
      'Кавер-группа — от 160 000 ₽',
      'Точный состав и технический райдер подтверждаются после выбора даты и площадки'
    ]
  }
];
---

<section id="formats" class="section service-formats" data-testid="jubilee-service-formats">
  <div class="container">
    <p class="section__eyebrow sr">Формат под вашу семью и площадку</p>
    <h2 class="section__title sr">Выберите подходящий формат</h2>
    <p class="section__subtitle service-formats__intro sr">Сначала показана базовая стоимость. Выберите дату, чтобы зафиксировать её в запросе и проверить доступность.</p>

    <div class="seasonal-pricing-calculator sr" data-jubilee-pricing data-testid="jubilee-pricing">
      <div class="seasonal-pricing-picker">
        <div class="seasonal-pricing-picker__summary" id="jubilee-pricing-hint">
          <strong data-pricing-selected-date>Базовая стоимость юбилея</strong>
          <span>Точная смета зависит от даты, площадки и состава</span>
        </div>
        <label class="seasonal-pricing-picker__control" for="jubilee-pricing-date">
          <span data-pricing-date-action>Выбрать дату</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" /></svg>
          <input id="jubilee-pricing-date" type="date" data-pricing-date aria-label="Выбрать дату юбилея" aria-describedby="jubilee-pricing-hint" />
        </label>
      </div>

      <div class="seasonal-pricing-options" aria-live="polite" aria-label="Стоимость трёх форматов юбилея">
        {formats.map((format, index) => (
          <article class="seasonal-price-option">
            <div class="seasonal-price-option__copy">
              <p class="seasonal-price-option__number">0{index + 1} · {format.name}</p>
              <h3>{format.title}</h3>
              <p>{format.note}</p>
            </div>
            <div class="seasonal-price-option__quote">
              <div class="seasonal-price-option__price-line">
                <span class="seasonal-price-option__date" data-pricing-caption hidden></span>
                <div class="seasonal-price-option__amount-row">
                  <output class="seasonal-price-option__value">от {rubles(format.price)}</output>
                  <span class="seasonal-price-option__extension">
                    <span>Доп. час</span>
                    <output>{rubles(format.extension)}</output>
                  </span>
                </div>
              </div>
            </div>
            <details class="seasonal-price-option__disclosure">
              <summary class="seasonal-price-option__toggle">
                <span class="seasonal-price-option__toggle-closed">Что входит</span>
                <span class="seasonal-price-option__toggle-open">Скрыть состав</span>
              </summary>
              <div class="seasonal-price-option__details">
                <p class="seasonal-price-option__details-title">{format.title}</p>
                <ul>{format.items.map((item) => <li>{item}</li>)}</ul>
                {format.detailsHref && <a class="seasonal-price-option__details-link" href={format.detailsHref}>Подробнее о кавер-группе <span aria-hidden="true">→</span></a>}
              </div>
            </details>
          </article>
        ))}
      </div>

      <div class="seasonal-pricing-result">
        <button class="pricing-contact-link" type="button" data-contact-open data-contact-source="formats_consultation" data-contact-intent="date_check" data-contact-placement="formats">Уточнить доступность даты и состав <span aria-hidden="true">→</span></button>
      </div>
    </div>
  </div>
</section>
