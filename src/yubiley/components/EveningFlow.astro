---
import { jubileeEveningStages } from '../data/jubilee';
---

<section id="evening-flow" class="section evening-flow" data-testid="jubilee-evening-flow">
  <div class="container">
    <p class="section__eyebrow sr">От сбора гостей до финала</p>
    <h2 class="section__title sr">Как проходит юбилей</h2>
    <p class="section__subtitle evening-flow__intro sr">У вечера есть понятный ритм, но сценарий собирается под именинника, семью и гостей.</p>

    <div class="evening-flow__grid">
      {jubileeEveningStages.map(([title, text], index) => (
        <article class="evening-flow__card sr">
          <div class="evening-flow__heading">
            <span class="evening-flow__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
          </div>
          <p>{text}</p>
        </article>
      ))}
    </div>

    <figure class="evening-flow__media sr">
      <picture>
        <source
          type="image/avif"
          srcset="/yubiley-assets/assets/photos/evening-flow/jubilee-evening-flow-768.avif 768w, /yubiley-assets/assets/photos/evening-flow/jubilee-evening-flow-1536.avif 1536w"
          sizes="(max-width: 768px) calc(100vw - 36px), 1180px"
        />
        <source
          type="image/webp"
          srcset="/yubiley-assets/assets/photos/evening-flow/jubilee-evening-flow-768.webp 768w, /yubiley-assets/assets/photos/evening-flow/jubilee-evening-flow-1536.webp 1536w"
          sizes="(max-width: 768px) calc(100vw - 36px), 1180px"
        />
        <img
          src="/yubiley-assets/assets/photos/evening-flow/jubilee-evening-flow-1536.webp"
          srcset="/yubiley-assets/assets/photos/evening-flow/jubilee-evening-flow-768.webp 768w, /yubiley-assets/assets/photos/evening-flow/jubilee-evening-flow-1536.webp 1536w"
          sizes="(max-width: 768px) calc(100vw - 36px), 1180px"
          width="1536"
          height="1024"
          loading="lazy"
          decoding="async"
          alt="Тимур Громов проводит программу за праздничным столом"
        />
      </picture>
    </figure>

    <div class="evening-flow__cta">
      <button class="btn btn-outline" type="button" data-contact-open>Обсудить программу юбилея</button>
    </div>
  </div>
</section>
