---
import { contact } from '../data/jubilee';
---
<div id="programs-modal" class="modal">
  <div class="modal__overlay"></div>
  <div class="modal__content">
    <button class="modal__close" aria-label="Закрыть">&times;</button>
    <h3>Два спокойных формата на выбор</h3>
    <ul class="programs-list">
      <li><b>Тёплый семейный вечер (6 часов)</b> — встреча гостей, поздравления, интерактив-лайт, музыка, финал и аккуратный тайминг без навязчивости.</li>
      <li><b>Камерный юбилей (4–5 часов)</b> — компактно: открытие, семейные истории, поздравления, музыкальные паузы и финальный блок.</li>
    </ul>
    <p class="muted">Подберём формат под именинника, семью и гостей. Могу прислать короткое видео-пример в WhatsApp.</p>
    <a class="btn btn-primary" href={contact.whatsappUrl} target="_blank" rel="noopener" data-cta="whatsapp_programs">
      Получить варианты в WhatsApp
    </a>
  </div>
</div>

<div id="letter-modal" class="modal">
  <div class="modal__overlay"></div>
  <button class="modal-nav modal-prev" aria-label="Назад">‹</button>
  <div class="modal__content letter-modal-content">
    <button class="modal__close" aria-label="Закрыть">×</button>
    <img class="letter-modal-img" src="" alt="Благодарственное письмо" />
  </div>
  <button class="modal-nav modal-next" aria-label="Вперёд">›</button>
</div>
