---
import { hero } from '../data/jubilee';
import HeroPortraitSlider from './HeroPortraitSlider.astro';
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text sr" id="hero-left">
      <h1><span class="h1-prefix">{hero.title}</span></h1>
      <p class="sub" id="hero-subtitle">{hero.subtitle}</p>
      <div class="hero-tags" id="hero-tags">
        {hero.tags.map((tag) => (
          <span class:list={['tag', tag.className]}>{tag.label}</span>
        ))}
      </div>
      <div class="hero__cta hero-actions" id="hero-actions">
        <button type="button" class="btn btn-primary" data-contact-open>Обсудить юбилей</button>
        <button class="btn btn-outline" data-contact-open data-form-source="hero_video">Назначить встречу</button>
      </div>
    </div>
    <HeroPortraitSlider alt={hero.imageAlt} />
  </div>
</section>
