---
import { siteMeta } from "../data/jubilee";
import { yandexMetrikaHead } from "../../site/metrika";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  pageCss?: string;
  pageScript?: string;
  includeMainAssets?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title = siteMeta.title,
  description = siteMeta.description,
  canonical = siteMeta.url,
  ogImage = siteMeta.ogImage,
  pageCss,
  pageScript,
  includeMainAssets = false,
  structuredData
} = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={siteMeta.themeColor} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/x-icon" href="/yubiley-assets/favicon2.ico" />
    <link rel="shortcut icon" href="/yubiley-assets/favicon2.ico" />
    {includeMainAssets && <link rel="preload" as="image" href="/yubiley-assets/assets/hero/portrait.webp" fetchpriority="high" />}

    {includeMainAssets && <link rel="stylesheet" href="/yubiley-assets/style.css?v=astro_1" />}
    {includeMainAssets && <link rel="stylesheet" href="/yubiley-assets/mobile.css?v=astro_1" media="(max-width: 768px)" />}
    {pageCss && <link rel="stylesheet" href={pageCss} />}

    <Fragment set:html={yandexMetrikaHead} />

    {includeMainAssets && <script src="https://play.boomstream.com/assets/javascripts/biframesdk.js" async is:inline></script>}

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <slot />
    {includeMainAssets && <script src="/yubiley-assets/script.js?v=astro_1" is:inline></script>}
    {pageScript && <script src={pageScript} is:inline></script>}
  </body>
</html>
