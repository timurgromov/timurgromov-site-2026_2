const transformedBodyHtml = filteredBodySource
  // Tilda t270 by default writes section hashes into history, so the browser can reopen /#about.
  // Keep anchor scrolling, but do not persist those hashes in the address bar.
  .replace(
    /<div class="t270" data-offset-top="-100"><\/div>/,
