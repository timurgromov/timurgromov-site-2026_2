<script>
  (function(){
    var popupId = 'consultation-contact-popup';
    var openSelector = '[data-consultation-popup-open]';
    var endpoint = /^(localhost|127\\.0\\.0\\.1)$/.test(window.location.hostname)
      ? 'http://127.0.0.1:8000/api/v1/site/consultation-request'
      : 'https://calcul.timurgromov.ru/api/v1/site/consultation-request';

    function getPopup(){
      return document.getElementById(popupId);
    }

    function resetLeadForm(popup){
      var form = popup ? popup.querySelector('[data-consultation-lead-form]') : null;
      var button = form ? form.querySelector('[data-contact-submit]') : null;
      if (!form) return;
      form.classList.remove('is-sent');
      setStatus(form, '');
      if (button) {
        button.disabled = false;
        button.classList.remove('is-loading');
        setTildaCtaLabel(button, 'Отправить');
      }
    }

    function openPopup(event){
      if (event) event.preventDefault();
      var popup = getPopup();
      if (!popup) return;
      resetLeadForm(popup);
      popup.classList.add('is-open');
      popup.setAttribute('aria-hidden', 'false');
      document.body.classList.add('tg-contact-popup-open');
    }

    function closePopup(){
      var popup = getPopup();
      if (!popup) return;
      popup.classList.remove('is-open');
      popup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('tg-contact-popup-open');
    }

    function setStatus(form, text){
      var status = form.querySelector('[data-contact-status]');
      if (status) status.textContent = text || '';
    }

    function setTildaCtaLabel(button, text){
      var label = button && button.querySelector('[data-tilda-cta-label]');
      if (label) {
        label.textContent = text;
      } else if (button) {
        button.textContent = text;
      }
    }

    document.addEventListener('click', function(event){
      var opener = event.target && event.target.closest && event.target.closest(openSelector);
      if (opener) {
        openPopup(event);
        return;
      }

      var closer = event.target && event.target.closest && event.target.closest('[data-consultation-popup-close]');
      if (closer) {
        event.preventDefault();
        closePopup();
      }
    });

    document.addEventListener('keydown', function(event){
      if (event.key === 'Escape') closePopup();
    });

    document.addEventListener('submit', function(event){
      var form = event.target && event.target.closest && event.target.closest('[data-consultation-lead-form]');
      if (!form) return;

      event.preventDefault();
      var button = form.querySelector('[data-contact-submit]');
      var formData = new FormData(form);
      var payload = {
        name: String(formData.get('name') || '').trim(),
        phone: String(formData.get('phone') || '').trim(),
        comment: String(formData.get('comment') || '').trim(),
        form_source: String(formData.get('form_source') || 'site_consultation_popup').trim(),
        page_url: window.location.href
      };

      if (!payload.name || !payload.phone) {
        setStatus(form, 'Укажите имя и телефон.');
        return;
      }

      setStatus(form, 'Отправляю...');
      if (button) {
        button.disabled = true;
        button.classList.add('is-loading');
        setTildaCtaLabel(button, 'Отправляем...');
      }

      fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload),
        credentials: 'omit'
      })
        .then(function(response){
          if (!response.ok) throw new Error('consultation request failed');
          form.reset();
          setStatus(form, '');
          form.classList.add('is-sent');
        })
        .catch(function(){
          setStatus(form, 'Не удалось отправить форму. Лучше написать в Telegram или MAX.');
          if (button) {
            button.disabled = false;
            button.classList.remove('is-loading');
            setTildaCtaLabel(button, 'Отправить');
          }
        })
        .finally(function(){
          if (button && !form.classList.contains('is-sent')) {
            button.disabled = false;
            button.classList.remove('is-loading');
            setTildaCtaLabel(button, 'Отправить');
          }
        });
    });
  }());
</script>`;

