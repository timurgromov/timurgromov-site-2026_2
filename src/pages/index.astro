const priceTabsController = `<script>
  (function(){
    var tabs = [
      { buttonId: '1738853167646', recordId: 'rec862317152' },
      { buttonId: '1738853388835', recordId: 'rec862334119' },
      { buttonId: '1738853518426', recordId: 'rec862336377' }
    ];

    function setActive(index){
      tabs.forEach(function(tab, currentIndex){
        var button = document.querySelector('#rec862304479 .tn-elem[data-elem-id="' + tab.buttonId + '"]');
        var record = document.getElementById(tab.recordId);
        var isActive = currentIndex === index;

        if (record) {
          record.style.display = isActive ? '' : 'none';
          record.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        }

        if (button) {
          button.classList.toggle('price-tab-active', isActive);
          button.classList.toggle('price-tab-inactive', !isActive);
          button.setAttribute('role', 'tab');
          button.setAttribute('aria-selected', isActive ? 'true' : 'false');
          button.setAttribute('tabindex', isActive ? '0' : '-1');
        }
      });
    }

    function init(){
      tabs.forEach(function(tab, index){
        var button = document.querySelector('#rec862304479 .tn-elem[data-elem-id="' + tab.buttonId + '"]');
        if (!button) return;
        button.addEventListener('click', function(event){
          event.preventDefault();
          setActive(index);
        });
      });
      document.querySelectorAll('[data-price-tab-target="includes"]').forEach(function(link){
        link.addEventListener('click', function(event){
          event.preventDefault();
          setActive(1);
        });
      });
      setActive(0);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>`;

