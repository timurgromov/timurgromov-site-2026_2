<script>
  (function(){
    var popupId = 'consultation-contact-popup';
    var openSelector = '[data-consultation-popup-open]';
    var endpoint = '/api/consultation-lead';

    function getPopup(){
      return document.getElementById(popupId);
    }

    function openPopup(event){
      if (event) event.preventDefault();
      var popup = getPopup();
      if (!popup) return;
      popup.classList.add('is-open');
      popup.setAttribute('aria-hidden', 'false');
      document.body.classList.add('tg-contact-popup-open');
    }

    function closePopup(){
      var popup = getPopup();
      if (!popup) return;
      popup.classList.remove('is-open');
      popup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('tg-contact-popup-open');
    }

    function setStatus(form, text){
      var status = form.querySelector('[data-contact-status]');
      if (status) status.textContent = text || '';
    }

    document.addEventListener('click', function(event){
      var opener = event.target && event.target.closest && event.target.closest(openSelector);
      if (opener) {
        openPopup(event);
        return;
      }

      var closer = event.target && event.target.closest && event.target.closest('[data-consultation-popup-close]');
      if (closer) {
        event.preventDefault();
        closePopup();
      }
    });

    document.addEventListener('keydown', function(event){
      if (event.key === 'Escape') closePopup();
    });

    document.addEventListener('submit', function(event){
      var form = event.target && event.target.closest && event.target.closest('[data-consultation-lead-form]');
      if (!form) return;

      event.preventDefault();
      var button = form.querySelector('button[type="submit"]');
      var formData = new FormData(form);
      setStatus(form, 'Отправляю...');
      if (button) button.disabled = true;

      fetch(endpoint, {
        method: 'POST',
        body: formData,
        credentials: 'same-origin'
      })
        .then(function(response){
          if (!response.ok) throw new Error('lead endpoint unavailable');
          form.reset();
          setStatus(form, 'Заявка отправлена. Тимур свяжется с вами.');
        })
        .catch(function(){
          setStatus(form, 'Форма готова для подключения к боту. Сейчас лучше написать в Telegram или MAX.');
        })
        .finally(function(){
          if (button) button.disabled = false;
        });
    });
  }());
</script>`;

