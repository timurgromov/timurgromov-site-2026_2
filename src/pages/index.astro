  body.clean-showreel-popup-open{
    overflow:hidden !important;
  }
  @media screen and (max-width:639px){
    .clean-showreel-popup{
      align-items:center;
      padding:max(84px, env(safe-area-inset-top)) 12px max(84px, env(safe-area-inset-bottom));
    }
