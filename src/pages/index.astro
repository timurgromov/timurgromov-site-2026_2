    var heroLoopEndPaddingSeconds = 0.18;

    function getHeroVideoSrc() {
      return window.matchMedia && window.matchMedia('(max-width: 639px)').matches
        ? '${heroCloudMobileVideoUrl}'
        : '${heroCloudDesktopVideoUrl}';
    }

    function isHeroVideoReadyToReveal(video) {
      return video && !video.paused && !video.ended && video.readyState >= 2;
    }

    function markHeroVideoStarted(video) {
      if (!isHeroVideoReadyToReveal(video)) return;

      var record = document.getElementById(heroRecordId);
      if (!record) return;

      record.classList.add('hero-video-started');
      record.classList.add('hero-preload-hidden');
    }

    function revealHeroOnPaintedFrame(video) {
      if (!video) return;
      if (typeof video.requestVideoFrameCallback === 'function') {
        video.requestVideoFrameCallback(function() {
          markHeroVideoStarted(video);
        });
        return;
      }
      window.setTimeout(function() {
        markHeroVideoStarted(video);
      }, heroRevealDelayMs);
    }

    function playHeroVideo(video) {
      if (!video) return;
      var record = document.getElementById(heroRecordId);
      var alreadyVisible = record && record.classList.contains('hero-video-started');
      if (!alreadyVisible && video.readyState >= 1 && video.currentTime > 0.05) {
        try {
          video.currentTime = heroLoopStartSeconds;
        } catch (error) {}
      }
      video.autoplay = true;
      video.setAttribute('autoplay', '');
      var playResult = video.play();
      if (playResult && typeof playResult.catch === 'function') {
        playResult.catch(function(){});
      }
    }

    function keepHeroLoopClean(video) {
      if (!video || !video.duration || Number.isNaN(video.duration)) return;
      if (video.duration - video.currentTime > heroLoopEndPaddingSeconds) return;
      video.currentTime = heroLoopStartSeconds;
      playHeroVideo(video);
    }

    function prepareHeroVideo(video) {
      var nextSrc = getHeroVideoSrc();
      video.muted = true;
      video.defaultMuted = true;
      video.loop = false;
      video.removeAttribute('loop');
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('poster', window.matchMedia('(max-width: 639px)').matches ? '${heroPosterMobileUrl}' : '${heroPosterDesktopUrl}');
      if (video.getAttribute('src') !== nextSrc) {
        video.setAttribute('src', nextSrc);
        video.load();
      }
      playHeroVideo(video);
    }

    function bindHeroPosterState() {
      var record = document.getElementById(heroRecordId);
      var shape = record && record.querySelector(heroShapeSelector);
      var video = shape && shape.querySelector('video');

      if (!record) return;

      if (video) {
        prepareHeroVideo(video);
