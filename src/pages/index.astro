<script>
  (function() {
    var heroRecordId = 'rec861352716';
    var heroShapeSelector = '.tn-elem__8613527161738731141089';
    var heroRevealDelayMs = 60;
    var heroLoopStartSeconds = 0;
    var heroLoopEndPaddingSeconds = 0.18;

    function getHeroVideoSrc() {
      return window.matchMedia && window.matchMedia('(max-width: 639px)').matches
        ? '${heroCloudMobileVideoUrl}'
        : '${heroCloudDesktopVideoUrl}';
    }

    function isHeroVideoReadyToReveal(video) {
      return video && !video.paused && !video.ended && video.readyState >= 2;
    }

    function markHeroVideoStarted(video) {
      if (!isHeroVideoReadyToReveal(video)) return;

      var record = document.getElementById(heroRecordId);
      if (!record) return;

      record.classList.add('hero-video-started');
      record.classList.add('hero-preload-hidden');
    }

    function revealHeroOnPaintedFrame(video) {
      if (!video) return;
      if (typeof video.requestVideoFrameCallback === 'function') {
        video.requestVideoFrameCallback(function() {
          markHeroVideoStarted(video);
        });
        return;
      }
      window.setTimeout(function() {
        markHeroVideoStarted(video);
      }, heroRevealDelayMs);
    }

    function playHeroVideo(video) {
      if (!video) return;
      var record = document.getElementById(heroRecordId);
      var alreadyVisible = record && record.classList.contains('hero-video-started');
      if (!alreadyVisible && video.readyState >= 1 && video.currentTime > 0.05) {
        try {
          video.currentTime = heroLoopStartSeconds;
        } catch (error) {}
      }
      video.autoplay = true;
      video.setAttribute('autoplay', '');
      var playResult = video.play();
      if (playResult && typeof playResult.catch === 'function') {
        playResult.catch(function(){});
      }
    }

    function keepHeroLoopClean(video) {
      if (!video || !video.duration || Number.isNaN(video.duration)) return;
      if (video.duration - video.currentTime > heroLoopEndPaddingSeconds) return;
      video.currentTime = heroLoopStartSeconds;
      playHeroVideo(video);
    }

    function prepareHeroVideo(video) {
      var nextSrc = getHeroVideoSrc();
      video.muted = true;
      video.defaultMuted = true;
      video.loop = false;
      video.removeAttribute('loop');
      video.setAttribute('muted', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('poster', window.matchMedia('(max-width: 639px)').matches ? '${heroPosterMobileUrl}' : '${heroPosterDesktopUrl}');
      if (video.currentSrc !== nextSrc && video.getAttribute('src') !== nextSrc) {
        video.setAttribute('src', nextSrc);
        video.load();
      }
      playHeroVideo(video);
    }

    function bindHeroPosterState() {
      var record = document.getElementById(heroRecordId);
      var shape = record && record.querySelector(heroShapeSelector);
      var video = shape && shape.querySelector('video');

      if (!record) return;

      if (video) {
        prepareHeroVideo(video);
        if (!video.dataset.heroPosterBound) {
          video.dataset.heroPosterBound = 'true';
          video.addEventListener('loadedmetadata', function() { playHeroVideo(video); });
          video.addEventListener('loadeddata', function() { playHeroVideo(video); });
          video.addEventListener('canplay', function() { playHeroVideo(video); });
          video.addEventListener('playing', function() { revealHeroOnPaintedFrame(video); });
          video.addEventListener('timeupdate', function() {
            markHeroVideoStarted(video);
            keepHeroLoopClean(video);
          });
          video.addEventListener('canplay', function() {
            window.setTimeout(function() { markHeroVideoStarted(video); }, heroRevealDelayMs);
          });
          video.addEventListener('ended', function() {
            video.currentTime = heroLoopStartSeconds;
            playHeroVideo(video);
          });
        }
        markHeroVideoStarted(video);
        return;
      }

      var observer = new MutationObserver(function() {
        bindHeroPosterState();
      });
      observer.observe(record, { childList: true, subtree: true });
      window.setTimeout(function() {
        observer.disconnect();
      }, 12000);
    }

    function syncHeroHeaderState() {
      document.documentElement.classList.toggle('hero-header-solid', window.scrollY > 520);
    }

    bindHeroPosterState();
    syncHeroHeaderState();
    document.addEventListener('click', function() {
      var record = document.getElementById(heroRecordId);
      var video = record && record.querySelector(heroShapeSelector + ' video');
      playHeroVideo(video);
    }, { passive: true });
    document.addEventListener('touchstart', function() {
      var record = document.getElementById(heroRecordId);
      var video = record && record.querySelector(heroShapeSelector + ' video');
      playHeroVideo(video);
    }, { passive: true });
    window.addEventListener('scroll', syncHeroHeaderState, { passive: true });
    window.addEventListener('resize', function() {
      syncHeroHeaderState();
      bindHeroPosterState();
    });
    window.addEventListener('pageshow', syncHeroHeaderState);
    window.addEventListener('load', bindHeroPosterState);
  })();
</script>`;
