<script>
  (function(){
    var popupId = 'clean-showreel-popup';
    var videoItems = ${cleanVideoPopupConfig};
    var videoByHook = {};

    videoItems.forEach(function(item){
      videoByHook[item.hook] = item;
    });

    function getPopup(){
      return document.getElementById(popupId);
    }

    function getVideo(){
      var popup = getPopup();
      return popup ? popup.querySelector('video') : null;
    }

    function setTitle(item){
      var popup = getPopup();
      var title = popup ? popup.querySelector('[data-clean-showreel-title]') : null;
      if (title) title.textContent = item && item.title ? item.title : '';
    }

    function prepareVideo(item, shouldLoad){
      var video = getVideo();
      if (!video || !item) return null;
      video.controls = true;
      video.setAttribute('controls', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('preload', 'auto');
      if (video.getAttribute('src') !== item.src) {
        video.pause();
        video.setAttribute('src', item.src);
        if (shouldLoad) video.load();
      }
      return video;
    }

    function playVideo(video){
      if (!video) return;
      var playResult = video.play();
      if (playResult && typeof playResult.catch === 'function') {
        playResult.catch(function(){});
      }
    }

    function playOpenVideo(){
      var popup = getPopup();
      var video = getVideo();
      if (!popup || !video || !popup.classList.contains('is-open')) return;
      playVideo(video);
    }

    function openPopup(item, event){
      if (event) {
        event.preventDefault();
        event.stopPropagation();
        if (event.stopImmediatePropagation) event.stopImmediatePropagation();
      }
      var popup = getPopup();
      var video = prepareVideo(item, true);
      if (!popup || !video || !item) return;
      popup.classList.add('is-open');
      popup.setAttribute('aria-hidden', 'false');
      document.body.classList.add('clean-showreel-popup-open');
      setTitle(item);
      if (video.readyState >= 1) {
        try {
          video.currentTime = 0;
        } catch (error) {}
      }
      playVideo(video);
    }

    function closePopup(){
      var popup = getPopup();
      var video = getVideo();
      if (!popup) return;
      if (video) video.pause();
      popup.classList.remove('is-open');
      popup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('clean-showreel-popup-open');
    }

    document.addEventListener('click', function(event){
      var opener = event.target && event.target.closest && event.target.closest('a[href^="#popup:"]');
      var item = opener ? videoByHook[opener.getAttribute('href')] : null;
      if (item) {
        openPopup(item, event);
        return;
      }
      if (event.target && event.target.closest && event.target.closest('[data-clean-showreel-close]')) {
        event.preventDefault();
        closePopup();
      }
    }, true);

    document.addEventListener('pointerdown', function(event){
      var opener = event.target && event.target.closest && event.target.closest('a[href^="#popup:"]');
      var item = opener ? videoByHook[opener.getAttribute('href')] : null;
      if (item) prepareVideo(item, true);
    }, true);

    document.addEventListener('keydown', function(event){
      if (event.key === 'Escape') closePopup();
    });

    document.addEventListener('DOMContentLoaded', function(){
      var video = getVideo();
      if (!video || video.dataset.cleanPopupBound) return;
      video.dataset.cleanPopupBound = 'true';
      video.addEventListener('loadedmetadata', playOpenVideo);
      video.addEventListener('loadeddata', playOpenVideo);
      video.addEventListener('canplay', playOpenVideo);
      video.addEventListener('canplaythrough', playOpenVideo);
      video.addEventListener('stalled', playOpenVideo);
      video.addEventListener('waiting', playOpenVideo);
    });
  }());
</script>`;

const unusedTildaHeadAssets = [
