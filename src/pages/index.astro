    });

    function getPopup(){
      return document.getElementById(popupId);
    }

    function getVideo(){
      var popup = getPopup();
      return popup ? popup.querySelector('video') : null;
    }

    function isKnownPortraitAdvice(item){
      return !!(item && item.hook && item.hook.indexOf('#popup:video-sovet-') === 0);
    }

    function syncPopupLayout(video){
      var popup = getPopup();
      if (!popup || !video) return;
      var isPortrait =
        video.dataset.cleanVideoForcedPortrait === 'true' ||
        video.videoHeight > video.videoWidth;
      popup.classList.toggle('is-portrait', !!isPortrait);
      popup.classList.toggle('is-landscape', !!video.videoWidth && !isPortrait);
    }

    function syncVideoSize(video){
      if (!video || !video.videoWidth || !video.videoHeight) return;
      if (video.dataset.cleanVideoForcedAspectRatio) {
        video.style.aspectRatio = video.dataset.cleanVideoForcedAspectRatio;
        video.dataset.cleanVideoOrientation = 'portrait';
        syncPopupLayout(video);
        return;
      }
      video.style.aspectRatio = video.videoWidth + ' / ' + video.videoHeight;
      video.dataset.cleanVideoOrientation =
        video.videoHeight > video.videoWidth ? 'portrait' : 'landscape';
      syncPopupLayout(video);
    }

    function resetVideoSize(video){
      var popup = getPopup();
      if (!video) return;
      video.style.aspectRatio = '';
      delete video.dataset.cleanVideoOrientation;
      delete video.dataset.cleanVideoForcedAspectRatio;
      delete video.dataset.cleanVideoForcedPortrait;
      if (popup) {
        popup.classList.remove('is-portrait', 'is-landscape');
      }
    }

    function setTitle(item){
      var popup = getPopup();
      var title = popup ? popup.querySelector('[data-clean-showreel-title]') : null;
      if (title) title.textContent = item && item.title ? item.title : '';
    }

    function prepareVideo(item, shouldLoad){
      var video = getVideo();
      if (!video || !item) return null;
      video.controls = true;
      video.setAttribute('controls', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('preload', 'auto');
      resetVideoSize(video);
      if (isKnownPortraitAdvice(item)) {
        video.dataset.cleanVideoForcedPortrait = 'true';
        video.dataset.cleanVideoForcedAspectRatio = '9 / 16';
        video.style.aspectRatio = '9 / 16';
        syncPopupLayout(video);
      }
      if (video.getAttribute('src') !== item.src) {
        video.pause();
        video.setAttribute('src', item.src);
        if (shouldLoad) video.load();
      } else {
        syncVideoSize(video);
      }
      return video;
    }

    function playVideo(video){
      if (!video) return;
      var playResult = video.play();
      if (playResult && typeof playResult.catch === 'function') {
        playResult.catch(function(){});
      }
