      return window.innerWidth >= desktopBreakpoint;
    }

    function clearState(record){
      if (!record) return;
      stateClasses.forEach(function(stateClass){
        record.classList.remove(stateClass);
      });
    }

    function setState(stateClass){
      var record = getRecord();
      if (!record) return;
      clearState(record);
      if (isDesktop()) record.classList.add(stateClass);
    }

    function resetState(){
      var record = getRecord();
      if (!record) return;
      if (!isDesktop()) {
        clearState(record);
        return;
      }
      setState('tg-advice-preview-1');
    }

    function bind(){
      var record = getRecord();
      if (!record) return;

      if (record.dataset.tgAdvicePreviewBound === 'true') {
        resetState();
        return;
      }

      record.dataset.tgAdvicePreviewBound = 'true';

      hookStates.forEach(function(item){
        Array.prototype.slice.call(
          record.querySelectorAll('a[href="' + item.hook + '"]')
        ).forEach(function(link){
          [link, link.closest('.tn-elem')].filter(Boolean).forEach(function(target){
            if (target.dataset.tgAdvicePreviewHoverBound === 'true') return;
            target.dataset.tgAdvicePreviewHoverBound = 'true';
            function activatePreviewState(){
              if (!isDesktop()) return;
              setState(item.state);
            }
            target.addEventListener('mouseenter', activatePreviewState);
            target.addEventListener('pointerenter', activatePreviewState);
            target.addEventListener('mouseover', activatePreviewState);
            target.addEventListener('focusin', function(){
              if (!isDesktop()) return;
              setState(item.state);
            });
          });
        });
      });

      record.addEventListener('mouseleave', resetState);
      record.addEventListener('focusout', function(){
        window.requestAnimationFrame(function(){
          if (!record.contains(document.activeElement)) resetState();
        });
      });

      resetState();
    }

    document.addEventListener('DOMContentLoaded', bind);
    window.addEventListener('load', bind);
    window.addEventListener('pageshow', bind);
    window.addEventListener('resize', resetState);
  }());
</script>`;

