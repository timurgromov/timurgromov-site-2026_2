<script>
  (function(){
    var previewItems = ${casePreviewVideoConfig};
    var previewRevealDelaySeconds = 0.25;
    var previewLoopStartSeconds = 0.25;
    var previewRetryDelays = [120, 360, 900, 1800, 3200];
    var previewObserver = null;

    function isReadyToReveal(video){
      return video && !video.paused && !video.ended && video.readyState >= 2 && video.currentTime >= previewRevealDelaySeconds;
    }

    function markReady(video){
      if (!isReadyToReveal(video)) return;
      var shape = video.closest && video.closest('.tn-elem');
      if (shape) shape.classList.add('case-preview-video-ready');
    }

    function tryPlay(video){
      if (!video) return;
      if (video.readyState >= 1 && video.currentTime < previewLoopStartSeconds) {
        try {
          video.currentTime = previewLoopStartSeconds;
        } catch (error) {}
      }
      var playResult = video.play();
      if (playResult && typeof playResult.catch === 'function') {
        playResult.catch(function(){});
      }
    }

    function queuePreviewRetries(video){
      if (!video || video.dataset.casePreviewRetrying === 'true') return;
      video.dataset.casePreviewRetrying = 'true';
      previewRetryDelays.forEach(function(delay, index){
        window.setTimeout(function(){
          tryPlay(video);
          markReady(video);
          if (index === previewRetryDelays.length - 1) {
            video.dataset.casePreviewRetrying = '';
          }
        }, delay);
      });
    }

    function ensureVideoLoaded(video){
      if (!video) return false;
      var src = video.dataset.casePreviewSrc || video.getAttribute('data-src');
      if (!src) return false;
      if (video.getAttribute('src') !== src) {
        video.setAttribute('preload', 'metadata');
        video.setAttribute('src', src);
        video.load();
      }
      return true;
    }

    function prepareVideo(video, src){
      video.autoplay = true;
      video.muted = true;
      video.defaultMuted = true;
      video.loop = true;
      video.volume = 0;
      video.setAttribute('autoplay', '');
      video.setAttribute('muted', '');
      video.setAttribute('loop', '');
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('preload', 'none');
      video.dataset.casePreviewSrc = src;
    }

    function activatePreview(video){
      if (!ensureVideoLoaded(video)) return;
      tryPlay(video);
      markReady(video);
      queuePreviewRetries(video);
    }

    function isNearViewport(element){
      if (!element || !element.getBoundingClientRect) return false;
      var rect = element.getBoundingClientRect();
      var margin = Math.min(900, Math.max(420, window.innerHeight || 720));
      return rect.bottom >= -margin && rect.top <= (window.innerHeight || 720) + margin;
    }

    function bindCasePreviewObserver(){
      if (!('IntersectionObserver' in window)) return;
      if (!previewObserver) {
        previewObserver = new IntersectionObserver(function(entries){
          entries.forEach(function(entry){
            if (!entry.isIntersecting) return;
            var video = entry.target && entry.target.querySelector('.case-preview-native-video');
            if (video) activatePreview(video);
          });
        }, { rootMargin: '650px 0px', threshold: 0.01 });
      }
      previewItems.forEach(function(item){
        var shape = document.querySelector(item.shapeSelector);
        if (!shape || shape.dataset.casePreviewObserved) return;
        shape.dataset.casePreviewObserved = 'true';
        previewObserver.observe(shape);
      });
    }

    function bindCasePreviews(){
      previewItems.forEach(function(item){
        var shape = document.querySelector(item.shapeSelector);
        var video = shape && shape.querySelector('.case-preview-native-video');
        if (!video) return;
        prepareVideo(video, item.src);
        if (!video.dataset.casePreviewBound) {
          video.dataset.casePreviewBound = 'true';
          video.addEventListener('loadedmetadata', function(){ activatePreview(video); });
          video.addEventListener('loadeddata', function(){ activatePreview(video); });
          video.addEventListener('playing', function(){ markReady(video); });
          video.addEventListener('timeupdate', function(){ markReady(video); });
          video.addEventListener('canplay', function(){
            activatePreview(video);
            window.setTimeout(function(){ markReady(video); }, previewRevealDelaySeconds * 1000);
          });
          video.addEventListener('canplaythrough', function(){ activatePreview(video); });
          video.addEventListener('waiting', function(){ activatePreview(video); });
          video.addEventListener('stalled', function(){ activatePreview(video); });
          video.addEventListener('suspend', function(){ activatePreview(video); });
        }
      });
      bindCasePreviewObserver();
      activateVisiblePreviews();
    }

    function activateVisiblePreviews(){
      previewItems.forEach(function(item){
        var shape = document.querySelector(item.shapeSelector);
        var video = shape && shape.querySelector('.case-preview-native-video');
        if (video && isNearViewport(shape)) activatePreview(video);
      });
    }

    function forceCaseHoverAnimation(element, reverse){
      if (!element) return;

      element.classList.remove('t-sbs-anim_started', 't-sbs-anim_reversed', 't-sbs-anim_playing');
      void element.offsetWidth;
      element.classList.add('t-sbs-anim_started');

      if (reverse) {
        element.classList.add('t-sbs-anim_reversed');
      }
    }

    function getCaseHoverTriggers(record, animatedElement){
      var triggerIds = (animatedElement.getAttribute('data-animate-sbs-trgels') || '')
        .split(',')
        .map(function(id){ return id.trim(); })
        .filter(Boolean);

      if (!triggerIds.length) return [animatedElement];

      return triggerIds
        .map(function(id){
          return record.querySelector('.tn-elem__862347176' + id + ', .tn-group__862347176' + id);
        })
        .filter(Boolean);
    }

    function bindCasePortfolioHover(){
      var record = document.getElementById('rec862347176');
      if (!record) return;

      var animatedElements = Array.prototype.slice.call(
        record.querySelectorAll('[data-animate-sbs-event="hover"]')
      );
      var triggerMap = new Map();

      animatedElements.forEach(function(animatedElement){
        getCaseHoverTriggers(record, animatedElement).forEach(function(trigger){
          if (!triggerMap.has(trigger)) triggerMap.set(trigger, []);
          triggerMap.get(trigger).push(animatedElement);
        });
      });

      triggerMap.forEach(function(elements, trigger){
        var hoverTarget = trigger.querySelector('.tn-molecule, .tn-atom') || trigger;
        if (hoverTarget.dataset.caseHoverBridgeBound === 'true') return;
        hoverTarget.dataset.caseHoverBridgeBound = 'true';
        trigger.dataset.caseHoverBridgeBound = 'true';

        hoverTarget.addEventListener('mouseenter', function(){
          elements.forEach(function(element){ forceCaseHoverAnimation(element, false); });
        });

        hoverTarget.addEventListener('mouseleave', function(){
          elements.forEach(function(element){ forceCaseHoverAnimation(element, true); });
        });
      });
    }

    bindCasePreviews();
    bindCasePortfolioHover();
    document.addEventListener('click', activateVisiblePreviews, { passive:true });
    document.addEventListener('touchstart', activateVisiblePreviews, { passive:true });
