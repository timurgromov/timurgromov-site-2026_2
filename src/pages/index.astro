  .concat(
    `<script>
      (function() {
        function hideTildaBranding() {
          var labels = document.querySelectorAll('.t-tildalabel, .t-tildalabel-free, #tildacopy');
          labels.forEach(function(label) {
            if (label && label.parentNode) {
              label.parentNode.removeChild(label);
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', hideTildaBranding);
        } else {
          hideTildaBranding();
        }

        try {
          new MutationObserver(function() {
            hideTildaBranding();
          }).observe(document.documentElement, {
            childList: true,
            subtree: true,
          });
        } catch (error) {
          // Mutations API can be unavailable in some old browsers; fallback to periodic cleanup.
          setInterval(hideTildaBranding, 700);
        }
      }());
    </script>`,
  );

