</style>
<script>
  (function(){
    var popupId = 'plan-delivery-popup';
    var openSelector = '[data-plan-popup-open]';
    var telegramPlanUrl = ${JSON.stringify(telegramPlanUrl)};
    var endpoint = /^(localhost|127\\.0\\.0\\.1)$/.test(window.location.hostname)
      ? 'http://127.0.0.1:8000/api/v1/site/tripwire-request'
      : 'https://calcul.timurgromov.ru/api/v1/site/tripwire-request';

    function getPopup(){
      return document.getElementById(popupId);
    }

    function setTripwireStatus(form, text){
      var status = form.querySelector('[data-tripwire-status]');
      if (status) status.textContent = text || '';
    }

    function setTildaCtaLabel(button, text){
      var label = button && button.querySelector('[data-tilda-cta-label]');
      if (label) {
        label.textContent = text;
      } else if (button) {
        button.textContent = text;
      }
    }

    function setTripwireLoading(form, isLoading){
      var button = form.querySelector('[data-tripwire-submit]');
      if (!button) return;
      button.disabled = isLoading;
      button.classList.toggle('is-loading', isLoading);
      setTildaCtaLabel(button, isLoading ? 'Отправляем...' : 'Получить сценарий');
    }

    function resetTripwireForm(form){
      if (!form) return;
      form.classList.remove('is-sent');
      setTripwireStatus(form, '');
      setTripwireLoading(form, false);
    }

    function resetPopupForms(popup){
      if (!popup) return;
      popup.classList.remove('is-tripwire-sent');
      popup.querySelectorAll('[data-tripwire-form]').forEach(resetTripwireForm);
    }

    function openPopup(event){
      if (event) event.preventDefault();
      var popup = getPopup();
      if (!popup) return;
      resetPopupForms(popup);
      popup.classList.add('is-open');
      popup.setAttribute('aria-hidden', 'false');
      document.body.classList.add('tg-plan-popup-open');
    }

    function closePopup(){
      var popup = getPopup();
      if (!popup) return;
      popup.classList.remove('is-open');
      popup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('tg-plan-popup-open');
    }

    document.addEventListener('click', function(event){
      var opener = event.target && event.target.closest && event.target.closest(openSelector);
      if (opener) {
        openPopup(event);
        return;
      }

      var closer = event.target && event.target.closest && event.target.closest('[data-plan-popup-close]');
      if (closer) {
        event.preventDefault();
        closePopup();
      }
    });

    document.addEventListener('keydown', function(event){
      if (event.key === 'Escape') closePopup();
    });

    document.addEventListener('submit', function(event){
      var form = event.target && event.target.closest && event.target.closest('[data-tripwire-form]');
      if (!form) return;

      event.preventDefault();
      var formData = new FormData(form);
      var payload = {
        role: String(formData.get('role') || '').trim(),
        wedding_timing: String(formData.get('wedding_timing') || '').trim(),
        wedding_location: String(formData.get('wedding_location') || '').trim(),
        details: String(formData.get('details') || '').trim(),
        form_source: String(formData.get('form_source') || 'site_plan_tripwire').trim(),
        page_url: window.location.href
      };

      if (!payload.role || !payload.wedding_timing || !payload.wedding_location) {
        setTripwireStatus(form, 'Выберите, кто вы, когда и где будет свадьба.');
        if (typeof form.reportValidity === 'function') form.reportValidity();
        return;
      }

      setTripwireStatus(form, 'Сохраняю ответы...');
      setTripwireLoading(form, true);

      fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload),
        credentials: 'omit'
      })
        .then(function(response){
          if (!response.ok) throw new Error('tripwire request failed');
          form.reset();
          setTripwireStatus(form, '');
          form.classList.add('is-sent');
          var popup = form.closest('.tg-plan-popup');
          if (popup) popup.classList.add('is-tripwire-sent');
          if (window.matchMedia && window.matchMedia('(pointer: coarse)').matches) {
            window.setTimeout(function(){
              window.location.href = telegramPlanUrl;
            }, 650);
          }
        })
        .catch(function(){
          setTripwireStatus(form, 'Не удалось сохранить ответы. Можно открыть Telegram напрямую.');
          setTripwireLoading(form, false);
        })
        .finally(function(){
          if (!form.classList.contains('is-sent')) {
            setTripwireLoading(form, false);
          }
        });
    });
  }());
</script>`;

