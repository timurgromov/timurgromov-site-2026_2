---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WeddingArticleHero from "../../components/WeddingArticleHero.astro";

const homeHref = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pageUrl = new URL(`${homeHref}articles/`, "https://timurgromov.ru").toString();
const socialImageUrl = new URL(
  `${homeHref}images/scenario-hero-host-bw-source.jpg`,
  "https://timurgromov.ru",
).toString();

const publishedArticles = [
  {
    href: `${homeHref}articles/byudzhet-svadby-v-moskve/`,
    number: "01",
    eyebrow: "Смета и приоритеты",
    title: "Бюджет свадьбы: как собрать смету без сюрпризов",
    description:
      "Из чего складываются расходы, какие решения сильнее всего меняют смету и как рассчитать свой вариант без чужих средних цифр.",
    tag: "С калькулятором",
  },
  {
    href: `${homeHref}articles/plan-podgotovki-k-svadbe/`,
    number: "02",
    eyebrow: "Подготовка",
    title: "Пошаговый план подготовки к свадьбе",
    description:
      "Как последовательно выбрать дату, формат, площадку и команду — от первого решения до готового плана дня.",
    tag: "12 шагов",
  },
  {
    href: `${homeHref}scenario/`,
    number: "03",
    eyebrow: "Сценарий вечера",
    title: "Как устроен сильный свадебный вечер",
    description:
      "Почему хороший сценарий держится не на конкурсах, а на состоянии гостей, понятном тайминге и последовательности событий.",
    tag: "5 минут чтения",
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: "https://timurgromov.ru/" },
    { "@type": "ListItem", position: 2, name: "Статьи", item: pageUrl },
  ],
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Статьи о свадьбе | Тимур Громов",
  description:
    "Материалы Тимура Громова о бюджете свадьбы, подготовке, сценарии, тайминге и атмосфере свадебного вечера.",
  url: pageUrl,
  hasPart: publishedArticles.map((article) => ({
    "@type": "Article",
    headline: article.title,
    description: article.description,
    url: new URL(article.href, "https://timurgromov.ru").toString(),
  })),
};
---

<BaseLayout
  title="Статьи о свадьбе | Тимур Громов"
  description="Материалы о бюджете свадьбы, подготовке, сценарии, тайминге и атмосфере свадебного вечера."
  canonical={pageUrl}
  ogImage={socialImageUrl}
  ogImageAlt="Тимур Громов"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)}></script>
  </Fragment>

  <main class="library-page">
    <WeddingArticleHero
      homeHref={homeHref}
      meta="Ведущий · Москва и Подмосковье"
      heightMode="compact"
      testId="articles-hub-hero"
    >
        <h1 slot="title">Статьи <em>о свадьбе</em></h1>
        <Fragment slot="lead">
          Здесь собраны все опубликованные материалы о бюджете, подготовке и
          сценарии свадебного дня.
        </Fragment>
    </WeddingArticleHero>

    <section class="library-section library-shell" aria-labelledby="published-title">
      <div class="library-section__head">
        <p class="library-eyebrow">Материалы</p>
        <h2 id="published-title">Выберите тему</h2>
      </div>

      <div class="library-list">
        {publishedArticles.map((article) => (
          <a class="library-card" href={article.href}>
            <div class="library-card__topline">
              <span>{article.number} · {article.eyebrow}</span>
              <span>{article.tag}</span>
            </div>
            <div class="library-card__body">
              <h3>{article.title}</h3>
              <p>{article.description}</p>
            </div>
            <strong>Читать материал <span aria-hidden="true">↗</span></strong>
          </a>
        ))}
      </div>
    </section>

    <footer class="library-footer">
      <div class="library-shell">
        <span>Тимур Громов</span>
        <p>Свадебный ведущий · Москва и Подмосковье</p>
        <a href={homeHref}>На главную</a>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  :global(html), :global(body) { background: #f7f1e8; color: #241d19; }

  .library-page {
    --bg: #f7f1e8;
    --ink: #241d19;
    --muted: rgba(36, 29, 25, 0.7);
    --line: rgba(36, 29, 25, 0.15);
    --accent: #fa4604;
    --dark: #1f1916;
    min-height: 100vh;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
  }

  .library-shell { width: min(100%, 1080px); margin: 0 auto; padding-inline: 24px; }

  .library-eyebrow { margin: 0 0 18px; color: var(--accent); font-size: 12px; letter-spacing: 0.3em; text-transform: uppercase; }

  .library-section h2, .library-card h3 {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    letter-spacing: 0;
  }

  .library-section { padding-block: clamp(72px, 8vw, 104px); }
  .library-section__head { margin-bottom: 34px; }
  .library-section__head h2 { font-size: clamp(34px, 3.8vw, 48px); line-height: 1; }

  .library-list { border-top: 1px solid var(--line); }
  .library-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .8fr) auto; align-items: center; gap: 40px; padding: 34px 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .library-card__topline { display: flex; justify-content: space-between; gap: 20px; color: var(--muted); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; }
  .library-card__topline span:last-child { display: none; }
  .library-card__body { min-width: 0; }
  .library-card h3 { max-width: 20ch; font-size: clamp(30px, 3vw, 42px); line-height: 1; }
  .library-card p { max-width: 560px; margin: 14px 0 0; color: var(--muted); font-size: 17px; line-height: 1.55; }
  .library-card > strong { justify-self: end; color: var(--ink); font-size: 14px; white-space: nowrap; }

  .library-footer { padding-block: 46px; background: var(--dark); color: #fffaf4; }
  .library-footer .library-shell { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 28px; }
  .library-footer > div > span { font: 600 28px/1 "Cormorant Garamond", Georgia, serif; }
  .library-footer p { margin: 0; color: rgba(255,250,244,.6); font-size: 13px; }
  .library-footer a { color: var(--accent); font-size: 13px; text-decoration: none; }

  @media (hover: hover) {
    .library-card > strong { transition: color .2s ease, transform .2s ease; }
    .library-card:hover > strong { color: var(--accent); transform: translateX(4px); }
  }

  @media (max-width: 760px) {
    .library-card { grid-template-columns: 1fr; gap: 18px; padding: 28px 0; }
    .library-card__topline span:last-child { display: inline; }
    .library-card h3 { font-size: clamp(30px, 8.5vw, 40px); }
    .library-card > strong { justify-self: start; }
    .library-footer .library-shell { grid-template-columns: 1fr; gap: 12px; }
  }

  @media (max-width: 479px) {
    .library-shell { padding-inline: 18px; }
    .library-card__topline { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>
