---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalculatorCtaPair from "../../components/CalculatorCtaPair.astro";

const homeHref = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const articlesHref = `${homeHref}articles/`;
const planHref = `${homeHref}articles/plan-podgotovki-k-svadbe/`;
const pageUrl = new URL(`${homeHref}articles/byudzhet-svadby-v-moskve/`, "https://timurgromov.ru").toString();
const socialImageUrl = new URL(`${homeHref}images/scenario-hero-host-bw-source.jpg`, "https://timurgromov.ru").toString();
const pageTitle = "Бюджет свадьбы в Москве: как рассчитать смету без сюрпризов | Тимур Громов";
const pageDescription = "Как собрать бюджет свадьбы в Москве и Подмосковье: структура сметы, приоритеты пары, скрытые доплаты и бесплатный свадебный калькулятор.";

const chapters = [
  {
    number: "01",
    id: "format-gosti-limit",
    title: "Формат, гости и лимит бюджета",
    body: [
      "Бюджет свадьбы начинается не с поиска цен, а с понимания, какой праздник вы хотите. Камерный ужин, классический банкет и большая загородная вечеринка требуют разных расходов. На смету влияют число гостей, длительность дня, площадка, сезон, состав команды и ваши главные пожелания.",
      "Сначала определите сумму, которую готовы потратить, и выберите несколько главных вещей. Для одной пары это площадка и ужин, для другой — музыка, фотографии или атмосфера свободной вечеринки. Так будет проще понять, без чего свадьба потеряет характер, а что можно упростить или убрать.",
    ],
    list: [
      "формат и продолжительность праздника;",
      "предварительный список гостей с учётом возможных изменений;",
      "сумма, которую вы готовы потратить, не рассчитывая на подарки;",
      "то, без чего свадьба не будет вашей, и то, что можно упростить.",
    ],
  },
  {
    number: "02",
    id: "ploshchadka-banket",
    title: "Площадка, банкет, напитки и условия",
    body: [
      "Площадку лучше не считать одной строкой. В Москве и Подмосковье итог зависит от меню, аренды, обслуживания, продолжительности праздника, возможности привезти свои напитки и подрядчиков, доступного оборудования и того, насколько зал уже подходит вам по атмосфере и оформлению.",
      "Красивый зал с подходящей мебелью, светом и зоной церемонии может позволить меньше потратить на декор. И наоборот: невысокая цена аренды может заметно вырасти, если отдельно оплачиваются продление, уборка, пробковый сбор, техника, монтаж или поздняя работа персонала.",
    ],
    list: [
      "что входит в меню, аренду и обслуживание;",
      "какие напитки можно привезти и на каких условиях;",
      "есть ли обязательные подрядчики или минимальный заказ;",
      "как считаются продление, монтаж, уборка и дополнительные часы;",
      "что происходит при изменении числа гостей, переносе или отмене.",
    ],
  },
  {
    number: "03",
    id: "komanda",
    title: "Команда: ведущий, DJ, фото, видео и организация",
    body: [
      "Команда — это не просто список специалистов. Цена зависит от того, что входит в работу, сколько времени займёт подготовка и сам праздник, какое нужно оборудование, понадобится ли второй специалист и как далеко ехать. Поэтому предложения лучше сравнивать не только по итоговой сумме.",
      "Ведущий и DJ отвечают за ритм вечера и техническую готовность программы. Фотограф и видеограф — за то, что останется после свадьбы. Координатор следит, чтобы в день праздника всё шло по плану, а организатор ведёт всю подготовку: помогает с концепцией, поиском команды и сметой. Эти роли нужны не каждой паре и могут отличаться по объёму работы.",
    ],
    list: [
      "что именно специалист делает до свадьбы и в день события;",
      "сколько часов и какие этапы входят;",
      "нужны ли техника, ассистент, второй оператор или дополнительный комплект;",
      "как оплачиваются дорога, ранний выезд, продление и изменения задачи;",
      "какой результат и в какой срок вы получаете после свадьбы.",
    ],
  },
  {
    number: "04",
    id: "vizualnaya-chast",
    title: "Образы, декор, флористика и полиграфия",
    body: [
      "Расходы на оформление часто растут постепенно: сначала цветы, затем декор, печать, доставка и монтаж. Поэтому в смете лучше отдельно записать образы пары, оформление пространства, флористику и полиграфию. Так будет видно, что действительно создаёт нужную атмосферу, а что можно убрать.",
      "На результат влияют не только объём цветов или количество конструкций. Важны исходный интерьер, сезонность и доступность материалов, повторное использование оформления между зонами, время на монтаж и демонтаж, сложность доставки и требования площадки.",
    ],
    list: [
      "платье, костюм, обувь, аксессуары и подготовка образов;",
      "букет, бутоньерка и личная флористика;",
      "церемония, столы, welcome-зона и навигация;",
      "приглашения, карточки рассадки, меню и другая полиграфия;",
      "доставка, монтаж, демонтаж и возврат арендованных предметов.",
    ],
  },
  {
    number: "05",
    id: "logistika-dopolneniya",
    title: "Логистика и дополнительные решения",
    body: [
      "Транспорт, размещение гостей, церемония, торт, шоу, живая музыка и дополнительная техника нужны не каждой свадьбе. Но если без них не получится выбранный формат, лучше записать каждый расход отдельно, а не прятать его в общей сумме.",
      "Особенно внимательно считайте загородные площадки Московской области: дорога команды, трансфер гостей, проживание, поздний выезд и время на монтаж могут увеличить расходы сразу по нескольким пунктам. Каждая дополнительная трата должна решать понятную задачу: создавать атмосферу, упрощать маршрут или поддерживать важный момент дня.",
    ],
    list: [
      "транспорт пары, команды и гостей;",
      "размещение, питание команды и бытовая логистика;",
      "выездная церемония и всё, что требуется для её проведения;",
      "торт, доставка, хранение и подача;",
      "музыканты, артисты, шоу и дополнительный свет или звук.",
    ],
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: "https://timurgromov.ru/" },
    { "@type": "ListItem", position: 2, name: "Статьи", item: new URL(articlesHref, "https://timurgromov.ru").toString() },
    { "@type": "ListItem", position: 3, name: "Бюджет свадьбы", item: pageUrl },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Бюджет свадьбы: из чего складывается смета и как её рассчитать",
  description: pageDescription,
  mainEntityOfPage: pageUrl,
  author: { "@type": "Person", name: "Тимур Громов", url: "https://timurgromov.ru/" },
  publisher: { "@type": "Person", name: "Тимур Громов" },
  image: socialImageUrl,
  about: ["бюджет свадьбы", "смета свадьбы", "расходы на свадьбу", "Москва", "Московская область"],
  inLanguage: "ru-RU",
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage={socialImageUrl}
  ogImageAlt="Тимур Громов"
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  </Fragment>

  <main class="budget-page" data-testid="wedding-budget-page">
    <header class="budget-hero" data-testid="wedding-budget-hero">
      <div class="budget-hero__media" aria-hidden="true"></div>
      <div class="budget-hero__overlay" aria-hidden="true"></div>
      <div class="budget-shell budget-hero__shell">
        <div class="budget-hero__kicker">
          <a class="budget-back" href={homeHref}>timurgromov.ru</a>
          <p class="budget-eyebrow">Авторский материал — <span>Тимур Громов</span></p>
        </div>
        <h1>Бюджет свадьбы: <em>из чего складывается смета</em> и как её рассчитать</h1>
        <p class="budget-lead">
          Нет одной суммы, которая подойдёт всем. На бюджет влияют формат,
          количество гостей, площадка, команда и то, что важно именно вам.
          Поэтому лучше сразу посчитать свою свадьбу, а не ориентироваться на
          чужие цифры.
        </p>
        <div class="budget-hero__actions">
          <CalculatorCtaPair placement="hero" theme="dark" />
        </div>
        <div class="budget-hero__meta">
          <div class="budget-hero__badge">Т</div>
          <div>
            <strong>Автор: Тимур Громов</strong>
            <span>Ведущий · Москва и Московская область</span>
          </div>
        </div>
      </div>
    </header>

    <article class="budget-shell budget-article" data-testid="wedding-budget-article">
      <section class="budget-answer" aria-labelledby="short-answer-title">
        <p class="budget-eyebrow">Короткий ответ</p>
        <h2 id="short-answer-title">Сколько стоит свадьба в Москве?</h2>
        <p>
          Столько, сколько требует выбранный формат и сколько вы готовы спокойно
          на него потратить. Даже при одинаковом количестве гостей сметы могут
          сильно отличаться: один зал уже создаёт нужную атмосферу, другому
          понадобится декор; одной паре важна большая команда, другой — камерный
          ужин и хорошая музыка. Поэтому расчёт начинается не с общей цифры, а
          со списка расходов.
        </p>
      </section>

      <nav class="budget-contents" aria-label="Содержание статьи">
        <span>В этой статье</span>
        <ol>
          {chapters.map((chapter) => <li><a href={`#${chapter.id}`}>{chapter.title}</a></li>)}
          <li><a href="#unexpected">Как избежать неожиданных доплат</a></li>
          <li><a href="#estimate">Как работать со сметой</a></li>
          <li><a href="#calculator">Как работает калькулятор</a></li>
        </ol>
      </nav>

      {chapters.map((chapter) => (
        <section class="budget-chapter" id={chapter.id}>
          <div class="budget-chapter__meta">
            <span class="budget-chapter__number">{chapter.number}</span>
            <h2>{chapter.title}</h2>
          </div>
          <div class="budget-chapter__content">
            {chapter.body.map((paragraph) => <p>{paragraph}</p>)}
            <ul>{chapter.list.map((item) => <li>{item}</li>)}</ul>
          </div>
        </section>
      ))}

      <aside class="budget-mid-cta" aria-labelledby="mid-cta-title">
        <div>
          <p class="budget-eyebrow">Посчитайте свою свадьбу</p>
          <h2 id="mid-cta-title">Выберите нужные расходы и соберите свою смету</h2>
          <p>Калькулятор откроется внутри выбранного мессенджера, а расчёт сохранится автоматически.</p>
        </div>
        <CalculatorCtaPair placement="mid_article" />
      </aside>

      <section class="budget-chapter" id="unexpected">
        <div class="budget-chapter__meta">
          <span class="budget-chapter__number">06</span>
          <h2>Как избежать неожиданных доплат</h2>
        </div>
        <div class="budget-chapter__content">
          <p>
            Доплаты появляются не потому, что выбран дорогой вариант, а потому,
            что какое-то условие не обсудили заранее. Когда сравниваете
            предложения, каждый раз уточняйте одно и то же: подготовку, часы
            работы, технику, дорогу, результат, продление и правила изменений.
          </p>
          <p>
            Все значимые договорённости фиксируйте письменно. Оставьте отдельный
            резерв, не распределяя его заранее по красивым идеям. И назначьте
            человека, который в день свадьбы принимает доставки, держит контакты
            команды и решает вопросы на месте: координатора или заранее
            согласованного близкого.
          </p>
          <ul>
            <li>сравнивайте не только цену, но и то, что в неё входит;</li>
            <li>проверяйте доплаты, ограничения и условия изменений до оплаты;</li>
            <li>держите резерв отдельной строкой;</li>
            <li>зафиксируйте ответственного за решения в день свадьбы.</li>
          </ul>
        </div>
      </section>

      <section class="budget-chapter" id="estimate">
        <div class="budget-chapter__meta">
          <span class="budget-chapter__number">07</span>
          <h2>Как работать со сметой</h2>
        </div>
        <div class="budget-chapter__content">
          <p>
            Смета полезна, когда она отражает именно вашу свадьбу. Начните с
            подходящих категорий, уберите лишние, затем заменяйте примерные суммы
            реальными предложениями и договорённостями. Если нужного расхода нет в
            списке, добавьте собственный расход.
          </p>
          <p>
            Возвращайтесь к расчёту после выбора площадки и каждого ключевого
            специалиста. Так изменения не теряются в переписках, а решение о
            новом элементе можно сразу сравнить с общим лимитом и вашими
            приоритетами.
          </p>
          <div class="budget-rule">
            <strong>Простой принцип</strong>
            <span>Сначала составьте список расходов. Затем внесите реальные предложения. В конце проверьте резерв и назначьте ответственного за день свадьбы.</span>
          </div>
        </div>
      </section>

      <section class="budget-calculator" id="calculator" data-testid="wedding-budget-calculator-guide">
        <div class="budget-calculator__head">
          <p class="budget-eyebrow">Бесплатный инструмент</p>
          <h2>Как работает калькулятор</h2>
          <p>
            В калькуляторе можно менять категории и суммы, а также добавлять свои
            расходы. Расчёт сохраняется автоматически, поэтому к нему легко
            вернуться. Готовую смету можно скопировать и вручную отправить
            близким или организатору.
          </p>
        </div>

        <div class="budget-screens" aria-label="Экраны свадебного калькулятора">
          <figure>
            <div class="budget-screen">
              <img src={`${homeHref}images/calculator-budget-items.webp`} alt="Выбор и настройка расходов свадебной сметы" width="720" height="1280" loading="lazy" />
            </div>
            <figcaption><span>01</span><strong>Выберите расходы</strong><p>Оставьте нужные категории и настройте их под свой формат.</p></figcaption>
          </figure>
          <figure>
            <div class="budget-screen">
              <img src={`${homeHref}images/calculator-budget-factors.webp`} alt="Подсказки о составе услуги и факторах стоимости" width="720" height="1280" loading="lazy" />
            </div>
            <figcaption><span>02</span><strong>Посмотрите подсказки</strong><p>В них написано, что обычно входит в услугу и от чего зависит цена.</p></figcaption>
          </figure>
          <figure>
            <div class="budget-screen">
              <img src={`${homeHref}images/calculator-budget-summary.webp`} alt="Итоговый экран со статусом сохранения и копированием сметы" width="720" height="1280" loading="lazy" />
            </div>
            <figcaption><span>03</span><strong>Сохраните и скопируйте</strong><p>Вернитесь к расчёту позже или скопируйте смету для ручной отправки.</p></figcaption>
          </figure>
        </div>

        <div class="budget-final-cta">
          <div>
            <p class="budget-eyebrow">Начать расчёт</p>
            <h3>Соберите смету своей свадьбы</h3>
            <p>Выберите мессенджер — калькулятор откроется внутри приложения.</p>
          </div>
          <CalculatorCtaPair placement="final" theme="dark" />
        </div>
      </section>

      <section class="budget-faq" aria-labelledby="faq-title">
        <p class="budget-eyebrow">Частые вопросы</p>
        <h2 id="faq-title">О бюджете свадьбы</h2>
        <details>
          <summary>Можно ли заранее назвать точную стоимость свадьбы?</summary>
          <p>Нет, пока не определены формат, гости, площадка, состав команды и условия услуг. Список статей даёт структуру, а точность появляется после ваших решений и предложений подрядчиков.</p>
        </details>
        <details>
          <summary>Что обязательно включить в смету свадьбы?</summary>
          <p>Обязательного списка для всех нет. Запишите всё, без чего не получится именно ваша свадьба: площадку и еду, нужную команду, образы, дорогу и дополнительные решения.</p>
        </details>
        <details>
          <summary>Когда пересматривать расчёт?</summary>
          <p>После каждого решения, которое меняет условия: площадки, числа гостей, состава команды, длительности дня или программы. Короткая регулярная проверка лучше большого пересчёта в конце.</p>
        </details>
      </section>

      <p class="budget-plan-link">
        Когда со сметой стало понятнее, переходите к
        <a href={planHref}>пошаговому плану подготовки к свадьбе</a>. Он поможет
        понять, какие решения принимать дальше и в каком порядке.
      </p>
    </article>

    <footer class="budget-footer">
      <div class="budget-shell budget-footer__inner">
        <a href={homeHref}>Тимур Громов</a>
        <nav aria-label="Навигация по материалам">
          <a href={articlesHref}>Все статьи</a>
          <a href={`${homeHref}scenario/`}>Сценарий вечера</a>
          <a href={`${homeHref}materials/`}>Материалы</a>
        </nav>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Instrument+Serif:ital@0;1&display=swap");

  :global(html), :global(body) { margin: 0; background: #f7f1e8; color: #241d19; }
  :global(*) { box-sizing: border-box; }

  .budget-page {
    --bg: #f7f1e8;
    --ink: #241d19;
    --muted: rgba(36, 29, 25, .76);
    --soft: rgba(36, 29, 25, .12);
    --accent: #fa4604;
    --dark: #1f1916;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
  }

  .budget-shell { width: min(100%, 1080px); margin: 0 auto; padding: 0 24px; }
  .budget-hero { position: relative; min-height: 92vh; overflow: hidden; background: var(--dark); color: #fffaf4; }
  .budget-hero__media { position: absolute; inset: 0; background: url("/images/scenario-hero-host-bw-source.jpg") 74% center / cover no-repeat; filter: grayscale(1) brightness(.7) contrast(1.02); transform: scale(1.02); }
