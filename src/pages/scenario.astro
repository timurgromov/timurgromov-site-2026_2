    position: absolute;
    inset: 0;
    background:
      url("/images/scenario-hero-host-bw-source.jpg") 74% center / cover no-repeat;
    filter: grayscale(1) brightness(0.72) contrast(1.02);
    transform: scale(1.02);
  }

  .scenario-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(16, 13, 12, 0.12) 0%, rgba(16, 13, 12, 0.3) 30%, rgba(16, 13, 12, 0.58) 74%, rgba(16, 13, 12, 0.74) 100%),
      linear-gradient(90deg, rgba(16, 13, 12, 0.74) 0%, rgba(16, 13, 12, 0.42) 37%, rgba(16, 13, 12, 0.18) 68%, rgba(16, 13, 12, 0.3) 100%),
      radial-gradient(circle at top right, rgba(250, 70, 4, 0.1), transparent 34%);
