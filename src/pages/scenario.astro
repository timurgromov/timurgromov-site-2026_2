---
import BaseLayout from "../layouts/BaseLayout.astro";
import { maxContactUrl, telegramMeetingUrl } from "../site/home-data";

const homeHref = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pageUrl = new URL(`${homeHref}scenario/`, "https://timurgromov.ru").toString();
const socialImageUrl = new URL(
  `${homeHref}images/scenario-hero-host-bw-source.jpg`,
  "https://timurgromov.ru",
).toString();
const eveningSteps = [
  "Сбор гостей",
  "Церемония",
  "Поздравления",
  "Знакомство гостей с вечером",
  "Общение и вовлечение",
  "Эмоциональный пик",
  "Завершение вечера",
  "Танцы",
];

const eveningStepRows = Array.from(
  { length: Math.ceil(eveningSteps.length / 2) },
  (_, rowIndex) => eveningSteps.slice(rowIndex * 2, rowIndex * 2 + 2),
);

const mistakes = [
  {
    title: "Плохо организованные тосты",
    description:
      "Если тосты не подготовлены, вечер быстро превращается в длинную очередь выступлений и утомляет гостей.",
  },
  {
    title: "Непродуманные подарки",
    description:
      "Когда гости не понимают, как вручать подарки, появляется лишняя суета и напряжение вокруг молодых.",
  },
  {
    title: "Сценарий, который существует только на бумаге",
    description:
      "Написать хороший план недостаточно. Его ещё нужно собрать под реальную площадку, тайминг и людей.",
  },
  {
    title: "Отсутствие взаимодействия между подрядчиками",
    description:
      "Кухня, площадка, фотограф, диджей и ведущий должны работать как одна команда, а не параллельно друг другу.",
  },
  {
    title: "Непонимание состояния гостей",
    description:
      "Главная ошибка — вести свадьбу по бумаге и не замечать, как в конкретный момент чувствует себя зал.",
  },
];

const portfolioLinks = [
  { label: "Свадьбы", value: "timurgromov.ru", href: "https://timurgromov.ru" },
  { label: "Корпоративы", value: "corp.timurgromov.ru", href: "https://corp.timurgromov.ru" },
  { label: "Instagram", value: "@timurgromov", href: "https://instagram.com/timurgromov" },
  { label: "Dzen", value: "dzen.ru/timurgromov", href: "https://dzen.ru/timurgromov" },
  { label: "Отзывы", value: "clck.ru/TZjT6", href: "https://clck.ru/TZjT6" },
];

const materialLinks = [
  {
    label: "Запись разбора",
    value: "Пошаговый план подготовки к свадьбе",
    href: "https://clck.ru/3RX8Nw",
  },
  {
    label: "Telegram-бот",
    value: "Свадебный калькулятор",
    href: "https://t.me/gromov_wedding_bot",
  },
];

const contactLinks = [
  { label: "Telegram", value: "@timurgromovv", href: "https://t.me/timurgromovv" },
  { label: "MAX", value: "clck.ru/3RRXHX", href: "https://clck.ru/3RRXHX" },
  { label: "Телефон", value: "+7 (925) 390-07-72", href: "tel:+79253900772" },
];
---

<BaseLayout
  title="Сценарий свадебного вечера | Тимур Громов"
  description="Логика современного свадебного вечера: тайминг, ключевые блоки и ошибки, которые чаще всего ломают атмосферу."
  canonical={pageUrl}
  ogImage={socialImageUrl}
  ogImageAlt="Тимур Громов ведёт свадебный вечер"
  ogType="article"
>
  <main class="scenario-page">
    <header class="scenario-hero">
      <div class="scenario-hero__media" aria-hidden="true"></div>
      <div class="scenario-hero__overlay"></div>
      <div class="scenario-shell scenario-hero__shell">
        <div class="scenario-hero__kicker">
          <a class="scenario-hero__back" href={homeHref}>timurgromov.ru</a>
          <div class="scenario-hero__eyebrow">
            Авторский материал — <span class="scenario-hero__eyebrow-name">Тимур Громов</span>
          </div>
        </div>
        <h1>
          Свадебный <em>сценарий</em>
        </h1>
        <p class="scenario-hero__lead">
          Почему сильный свадебный вечер строится не вокруг конкурсов, а вокруг
          состояния гостей, понятного тайминга и правильной последовательности
          событий.
        </p>
        <div class="scenario-hero__meta">
          <div class="scenario-hero__badge">Т</div>
          <div>
            <strong>Тимур Громов</strong>
            <span>Ведущий · 5 минут чтения</span>
          </div>
        </div>
      </div>
    </header>

    <article class="scenario-shell scenario-article">
      <section class="scenario-intro">
        <div class="scenario-eyebrow">Вступление</div>
        <div class="scenario-prose scenario-prose--dropcap">
          <p>
            За годы работы я заметил одну закономерность. Гости редко помнят
            конкурсы, точный сценарный план или последовательность активностей.
            Зато они прекрасно помнят свои ощущения от вечера.
          </p>
          <p>
            Было ли комфортно. Было ли понятно, что происходит. Было ли время
            пообщаться. Были ли моменты, которые действительно тронули.
          </p>
          <p>
            Именно поэтому хороший свадебный вечер строится не вокруг отдельных
            развлечений, а вокруг <strong>правильной последовательности событий</strong>.
          </p>
          <p>
            Этот материал поможет понять логику современного свадебного вечера и
            избежать самых распространённых ошибок при его планировании.
          </p>
          <p>
            Я показываю не универсальный шаблон, а принцип, по которому вечер
            становится спокойным, понятным и живым: гости не теряются,
            молодожёны не решают организационные вопросы на ходу, а важные
            моменты оказываются на своём месте.
          </p>
        </div>
      </section>

      <div class="scenario-ornament" aria-hidden="true">
        <span></span>
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 0L8 6L14 7L8 8L7 14L6 8L0 7L6 6L7 0Z" fill="currentColor"></path>
        </svg>
        <span></span>
      </div>

      <section class="scenario-section">
        <h2>Карта свадебного вечера</h2>
        <div class="scenario-prose">
          <p class="scenario-note">Время в примере условное, но логика рассчитана на длинный свадебный вечер</p>
          <p>
            Каждая свадьба индивидуальна, но сама логика движения вечера чаще
            всего остаётся похожей.
          </p>
        </div>
        <ol class="scenario-step-grid">
          {eveningStepRows.map((row, rowIndex) => (
            <li class="scenario-step-row">
              {row.map((step, cellIndex) => {
                const stepNumber = rowIndex * 2 + cellIndex + 1;

                return (
                  <div class="scenario-step-cell">
                    <span>{String(stepNumber).padStart(2, "0")}</span>
                    <strong>{step}</strong>
                  </div>
                );
              })}
            </li>
          ))}
        </ol>
      </section>

      <section class="scenario-timeblock">
        <div class="scenario-timeblock__meta">
          <div class="scenario-timeblock__time">16:00 — 16:40</div>
          <h2>Сбор гостей и Welcome</h2>
        </div>
        <div class="scenario-prose">
          <p>
            <strong>
              Welcome — это не просто время ожидания, а базовый набор удобств для
              гостей: где присесть пожилым людям, вода или шампанское, лёгкие
              закуски, нормальная музыка, комфортная температура и человек,
              который встречает и направляет. Если хочется, сюда же можно
              добавить небольшую фотозону для первых кадров.
            </strong>
          </p>
          <p>
            Кто-то приезжает заранее, кто-то задерживается, кто-то ищет парковку
            или помогает детям подготовиться к празднику. Поэтому большинству
            свадеб нужен этап, который позволяет людям спокойно войти в
            атмосферу вечера.
          </p>
          <p>Хороший Welcome помогает быстро понять:</p>
          <ul>
            <li>куда идти и где находится церемония или банкетный зал;</li>
            <li>как устроена рассадка;</li>
            <li>как организованы подарки и поздравления;</li>
            <li>что будет происходить дальше.</li>
          </ul>
          <p>
            На этом этапе ведущий работает не как артист, а скорее как стюард:
            помогает гостям сориентироваться и создаёт ощущение контроля.
            В своей работе я начинаю управлять вечером именно с этого момента:
            смотрю, где гости теряются, кому нужна подсказка и где может
            появиться лишняя пауза.
          </p>
          <p>
            Это незаметная работа, но именно с неё у гостей появляется ощущение:
            «нас ждут, про нас подумали, всё под контролем».
          </p>
          <aside class="scenario-callout scenario-callout--tip">
            <div>Из практики</div>
            <p>
              Большинство проблем начинается ещё до начала свадьбы: когда гости
              не понимают, куда идти, что делать и сколько ждать.
            </p>
          </aside>
          <aside class="scenario-callout scenario-callout--warn">
            <div>Частая ошибка</div>
            <p>
              Позвать гостей на полчаса раньше официального Welcome в расчёте,
              что опаздывающие всё равно придут вовремя. В итоге те, кто пришёл
              вовремя, ждут лишнее время, а те, кто и так опаздывает, всё равно
              опаздывают.
            </p>
          </aside>
          <aside class="scenario-callout scenario-callout--good">
            <div>Что работает лучше</div>
            <p>
              Для небольшой свадьбы обычно достаточно 30 минут Welcome. Если есть
              выездная церемония и большой поток гостей, лучше спокойно
              закладывать от 40 минут до полутора часов.
              Это ещё и самое удобное время для фотографий: гости уже в хорошем
              виде, с укладкой, макияжем, цветами и первым настроением вечера.
              Если всё пойдёт быстрее, начать раньше проще, чем потом искать
              время, которого не оказалось в расписании.
            </p>
          </aside>
        </div>
      </section>

      <section class="scenario-timeblock">
        <div class="scenario-timeblock__meta">
          <div class="scenario-timeblock__time">16:40 — 17:20</div>
          <h2>Церемония, поздравления и фотографии</h2>
        </div>
        <div class="scenario-prose">
          <p>
            Выездная церемония особенно хорошо работает, если официальный ЗАГС
            был в другой день или хочется сделать этот момент более личным.
          </p>
          <p>
            Сама церемония обычно занимает около 15 минут. Но многие недооценивают
            следующий этап — <strong>поздравления и фотографии</strong>.
          </p>
          <p>
            После церемонии гости подходят к молодожёнам, вручают цветы, делают
            совместные фотографии и говорят важные слова. На практике это один из
            самых полезных организационных моментов вечера.
          </p>
          <blockquote>
            «Я подошёл и поздравил молодых».
          </blockquote>
          <p>
            После этого гости спокойнее садятся за стол и меньше отвлекают пару
            в течение вечера. У людей закрывается внутренняя задача: поздравить,
            вручить подарок, сфотографироваться и почувствовать, что важный
            момент не был потерян.
          </p>
          <p>
            Если этот этап пропустить, молодожёнов начинают дёргать всю свадьбу:
            для фотографий, поздравлений и вручения подарков.
          </p>
          <p>
            Поэтому поздравления и фотографии после церемонии — это не просто
            красивый кусок тайминга, а способ снять лишнюю тревогу и сделать
            дальнейший вечер спокойнее.
            В реальном сценарии этот блок обычно идёт сразу после Welcome, когда
            основная часть гостей уже собралась, молодожёны приехали и можно
            спокойно выделить время на поздравления и фотографии, пока все ещё
            выглядят свежо.
          </p>
        </div>
      </section>

      <section class="scenario-timeblock">
        <div class="scenario-timeblock__meta">
          <div class="scenario-timeblock__time">17:20 — 18:20</div>
          <h2>Знакомство гостей с вечером</h2>
        </div>
        <div class="scenario-prose">
          <p>
            Первый банкетный блок нужен не только для того, чтобы сразу всех
            развлечь.
            Его главная задача — <strong>познакомить гостей с правилами вечера</strong>.
          </p>
          <p>
            К этому моменту люди уже приехали, увидели церемонию, поздравили
            молодожёнов и заняли свои места. Но они ещё не до конца понимают,
            что будет происходить дальше.
          </p>
          <p>Обычно их волнуют простые вопросы:</p>
          <ul>
            <li>когда будут тосты;</li>
            <li>нужно ли будет выступать;</li>
            <li>как организованы подарки;</li>
            <li>что вообще будет происходить дальше.</li>
          </ul>
          <p>
            Если эти вопросы не снять, люди сидят с внутренним напряжением.
            Поэтому в начале банкета важно не перегружать гостей, а дать им
            возможность спокойно поесть, выдохнуть и почувствовать, что вечер
            устроен понятно.
          </p>
          <h3>Как организовать подарки</h3>
          <p>
            Вопрос подарков вызывает у гостей больше тревоги, чем кажется.
            Кто-то хочет вручить подарок лично. Кто-то — вместе с тостом. Кто-то
            не любит публичность и хочет спокойно передать конверт без внимания
            всего зала.
          </p>
          <p>Обычно есть несколько удобных вариантов:</p>
          <ul>
            <li>вручить подарок после церемонии во время поздравлений;</li>
            <li>вручить подарок вместе с тостом;</li>
            <li>подойти к молодожёнам лично в одной из пауз вечера.</li>
          </ul>
          <aside class="scenario-callout scenario-callout--tip">
            <div>Из практики</div>
            <p>
              Гости намного спокойнее чувствуют себя на свадьбе, когда заранее
              понимают, как организованы подарки. Неопределённость создаёт
              больше напряжения, чем сам факт вручения.
            </p>
          </aside>
          <aside class="scenario-callout scenario-callout--good">
            <div>Что работает лучше</div>
            <p>
              Я заранее объясняю гостям, когда и как можно вручить подарок:
              после церемонии, вместе с тостом или в одной из пауз. Когда
              правило понятно, поздравления проходят спокойнее.
            </p>
          </aside>
          <h3>Как организовать тосты</h3>
          <p>
            На многих свадьбах именно тосты становятся главным источником
            стресса. Даже короткое публичное выступление для многих людей —
            это сильное напряжение, особенно если их могут вызвать внезапно.
          </p>
          <p>
            Есть гости, которые очень хотят сказать тост. Есть те, кто не хочет
            выступать ни при каких обстоятельствах. Есть люди, которые
            принимают решение уже по ходу праздника.
          </p>
          <p>
            Поэтому я заранее понимаю, кто из близких родственников и самых
            активных гостей будет говорить первым. Если у кого-то есть
            особенное поздравление, творческий номер или явное желание
            выступить, я прошу написать мне заранее в приглашении или общем
            чате. Так порядок тостов получается понятным, а поздравления не
            расползаются по всему вечеру.
          </p>
          <aside class="scenario-callout scenario-callout--tip">
            <div>Из практики</div>
            <p>
              Хорошо организованные тосты делают вечер комфортнее не только для
              выступающих, но и для всего зала. Когда гости понимают, что их не
              вызовут внезапно и не поставят перед залом без желания, атмосфера
              становится заметно легче.
            </p>
          </aside>
          <aside class="scenario-callout scenario-callout--good">
            <div>Что работает лучше</div>
            <p>
              Сначала я заранее собираю обязательные тосты близких родственников
              и самые важные поздравления, а потом уже выстраиваю порядок
              остального микрофона. Так у вечера появляется понятная логика и не
              возникает лишней суеты.
            </p>
          </aside>
        </div>
      </section>

      <section class="scenario-timeblock">
        <div class="scenario-timeblock__meta">
          <div class="scenario-timeblock__time">18:20 — 19:40</div>
          <h2>Общение и вовлечение</h2>
        </div>
        <div class="scenario-prose">
          <p>
            После первого блока гости уже понимают, как устроен вечер. Они
            поели, познакомились с атмосферой и увидели ведущего в работе.
            Теперь можно постепенно усиливать вовлечение.
          </p>
          <blockquote>
            Активности — не цель вечера. Активности — это инструмент.
          </blockquote>
          <p>Они помогают:</p>
          <ul>
            <li>объединять гостей;</li>
            <li>создавать поводы для общения;</li>
            <li>переключать внимание между важными моментами;</li>
            <li>давать людям возможность проявить себя.</li>
          </ul>
          <p>
            Гость не должен думать: «сейчас меня вызовут и поставят в неловкое
            положение». Он должен понимать: если захочу — поучаствую, если нет —
            спокойно понаблюдаю.
          </p>
          <p>
            Хорошие свадебные активности не строятся на принуждении, сарказме,
            пошлости или шутках за счёт человека.
          </p>
          <p>
            Хороший свадебный юмор строится на доброте, поддержке и совместном
            смехе. Задача ведущего — не быть главным героем вечера, а создать
            условия, в которых гости раскрываются сами.
            Во время вечера я слежу не только за таймингом, но и за состоянием
            зала: когда люди готовы включаться, а когда им лучше дать паузу.
            Я ориентируюсь не на количество активностей, а на то, как люди
            реагируют на них прямо здесь и сейчас.
          </p>
          <aside class="scenario-callout scenario-callout--warn">
            <div>Частая ошибка</div>
            <p>
              Пытаться заполнить каждую минуту программы активностями. Гости
              устают не от недостатка развлечений, а от отсутствия возможности
              спокойно пообщаться.
            </p>
          </aside>
          <aside class="scenario-callout scenario-callout--good">
            <div>Что работает лучше</div>
            <p>
              Строить вечер более крупными блоками по 40–60 минут и после каждого блока давать
              людям смену состояния: общение, музыка, еда, танцы или сильный
              эмоциональный момент.
            </p>
          </aside>
        </div>
      </section>

      <section class="scenario-inline-cta" aria-label="Обсудить вашу свадьбу">
        <div class="scenario-inline-cta__copy">
          <div class="scenario-inline-cta__eyebrow">Короткая встреча</div>
          <h3>Если уже хотите применить эту логику к своей свадьбе</h3>
          <p>
            Можно коротко обсудить формат, гостей, площадку и тайминг именно
            вашего вечера. Вы поймёте, где могут быть точки риска и как собрать
            всё надёжнее.
          </p>
        </div>
        <div class="scenario-inline-cta__actions">
          <a class="scenario-inline-cta__button" href={telegramMeetingUrl} target="_blank" rel="noopener noreferrer">
            Обсудить вашу свадьбу
          </a>
          <p class="scenario-inline-cta__note">30–50 минут, только про вашу свадьбу.</p>
        </div>
      </section>

      <section class="scenario-timeblock">
        <div class="scenario-timeblock__meta">
          <div class="scenario-timeblock__time">19:40 — 20:40</div>
          <h2>Эмоциональный пик</h2>
        </div>
        <div class="scenario-prose">
          <p>
            Многие пары хотят поставить первый танец как можно раньше. Это
            понятно: они переживают и хотят быстрее закрыть этот вопрос.
          </p>
          <p>
            Но эмоциональные события работают лучше тогда, когда зал уже
            разогрет: люди познакомились с атмосферой, поели, расслабились и
            начали общаться.
          </p>
          <p>
            В этот момент гости готовы не просто смотреть на событие, а
            эмоционально включиться в него.
          </p>
          <p>Ближе к середине или второй половине вечера хорошо работают:</p>
          <ul>
            <li>первый танец;</li>
            <li>благодарности родителям;</li>
            <li>семейные церемонии;</li>
            <li>трогательные традиции;</li>
            <li>сюрпризы гостей.</li>
          </ul>
          <aside class="scenario-callout scenario-callout--tip">
            <div>Из практики</div>
            <p>
              Первый танец работает не потому, что он стоит в сценарии. Он
              работает тогда, когда гости эмоционально готовы его увидеть.
              Поэтому я выбираю такие моменты не только по расписанию, а по тому,
              насколько зал уже включился в вечер.
            </p>
          </aside>
          <aside class="scenario-callout scenario-callout--good">
            <div>Что работает лучше</div>
            <p>
              Ставить трогательные моменты в тот момент, когда гости уже
              включились в вечер и готовы воспринимать эмоции, а не только
              следить за таймингом.
            </p>
          </aside>
        </div>
      </section>

      <section class="scenario-timeblock">
        <div class="scenario-timeblock__meta">
          <div class="scenario-timeblock__time">20:40 — 21:40</div>
          <h2>Завершение вечера</h2>
        </div>
        <div class="scenario-prose">
          <p>
            Финал формирует послевкусие свадьбы. Поэтому завершение вечера
            требует не меньше внимания, чем его начало.
          </p>
          <p>
            Часто считается, что торт должен быть самым последним событием
            программы. На практике это не всегда удобно: от выноса торта до
            первого съеденного кусочка может пройти 30–40 минут.
          </p>
          <p>
            Поэтому торт чаще стоит рассматривать как <strong>переход к
            финальной части вечера</strong>, а не как последнюю точку программы.
          </p>
          <p>
            После него могут быть благодарности, красивые финальные слова,
            семейная церемония или общий момент для гостей. Сильный финал не
            обязан быть сложным, но он должен быть понятным и завершённым.
          </p>
          <p>
            Гости должны почувствовать, что вечер закончился красиво, а не
            просто оборвался.
          </p>
          <aside class="scenario-callout scenario-callout--good">
            <div>Что работает лучше</div>
            <p>
              Планировать торт не как последнюю точку, а как переход к финальной
              части вечера. Тогда гости успевают получить десерт, а финал не
              разваливается по времени.
            </p>
          </aside>
        </div>
      </section>

      <div class="scenario-ornament" aria-hidden="true">
        <span></span>
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 0L8 6L14 7L8 8L7 14L6 8L0 7L6 6L7 0Z" fill="currentColor"></path>
        </svg>
        <span></span>
      </div>

      <section class="scenario-section">
        <h2>Пять вещей, которые чаще всего ломают свадебный вечер</h2>
        <ol class="scenario-mistakes">
          {mistakes.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="scenario-thesis">
        <div class="scenario-eyebrow scenario-eyebrow--light">Главная мысль</div>
        <p>
          Нет универсального сценария свадьбы. Есть <em>логика движения вечера</em>.
        </p>
        <p class="scenario-thesis__sub">
          Главная задача ведущего — не проводить конкурсы, а управлять состоянием
          гостей и движением вечера. Когда эта задача решена, гостям комфортно,
          молодожёны отдыхают, а важные моменты оказываются на своём месте.
          Именно это я и собираю на подготовке: не набор развлечений, а понятный
          ритм, в котором людям легко быть внутри праздника.
        </p>
      </section>
    </article>

    <section class="scenario-cta">
      <div class="scenario-shell scenario-cta__shell">
        <div class="scenario-cta__copy">
          <div class="scenario-eyebrow">Встреча-знакомство</div>
          <h2>
            Если уже выбираете ведущего — <em>давайте познакомимся</em>
          </h2>
          <p class="scenario-cta__lead">На встрече разберём:</p>
          <ul class="scenario-cta__topic-list">
            <li>формат свадьбы и состав гостей;</li>
            <li>площадку, логистику и тайминг;</li>
            <li>важные вопросы по программе и ходу вечера.</li>
          </ul>
        </div>
        <div class="scenario-cta__actions">
          <a class="scenario-cta__button" href={telegramMeetingUrl} target="_blank" rel="noopener noreferrer">
            Записаться на встречу
          </a>
          <ul class="scenario-cta__proof-list">
            <li>без обязательств</li>
            <li>именно про вашу свадьбу</li>
          </ul>
          <p class="scenario-cta__mini-note">30–50 минут. Обсудим формат, площадку и тайминг вашего вечера.</p>
          <div class="scenario-cta__secondary">
            <a href={telegramMeetingUrl} target="_blank" rel="noopener noreferrer">Написать в Telegram</a>
            <a href={maxContactUrl} target="_blank" rel="noopener noreferrer">Написать в MAX</a>
            <a href="tel:+79253900772">+7 925 390 07 72</a>
          </div>
        </div>
        <p class="scenario-cta__result">
          Вы поймёте мой подход, подхожу ли я вам как ведущий и как может быть
          устроен именно ваш вечер.
        </p>
        <p class="scenario-cta__note">
          Встреча бесплатная и ни к чему не обязывает.
        </p>
      </div>
    </section>

    <footer class="scenario-footer">
      <div class="scenario-shell scenario-footer__shell">
        <div class="scenario-eyebrow scenario-eyebrow--light">Ведущий</div>
        <h2>Тимур Громов</h2>
        <div class="scenario-footer__grid">
          <section>
            <h3>Ролики, отзывы и примеры работ</h3>
            <ul class="scenario-contact-list">
              {portfolioLinks.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    <span>{link.label}</span>
                    <strong>{link.value}</strong>
                  </a>
                </li>
              ))}
            </ul>
          </section>
          <section>
            <h3>Полезные материалы</h3>
            <ul class="scenario-contact-list">
              {materialLinks.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    <span>{link.label}</span>
                    <strong>{link.value}</strong>
                  </a>
                </li>
              ))}
            </ul>
            <div class="scenario-footer__contact-group">
              <h3 class="scenario-footer__contacts">Связаться со мной</h3>
              <ul class="scenario-contact-list">
                {contactLinks.map((link) => (
                  <li>
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                      <span>{link.label}</span>
                      <strong>{link.value}</strong>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        </div>
        <div class="scenario-footer__bottom">
          <span>© 2026 Тимур Громов</span>
          <a href={homeHref}>Вернуться на главную</a>
        </div>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Instrument+Serif:ital@0;1&display=swap");

  :global(html),
