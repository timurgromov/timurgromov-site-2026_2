---
import BaseLayout from "../layouts/BaseLayout.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pageUrl = new URL(`${basePath}materials/`, "https://timurgromov.ru").toString();
const socialImageUrl = new URL(
  `${basePath}images/tild3137-3330-4364-b639-393637636430___2.jpg`,
  "https://timurgromov.ru",
).toString();

const telegramContactUrl = "https://t.me/timurgromovv";
const maxContactUrl =
  "https://max.ru/u/f9LHodD0cOIvnExDiltaWpLlPOHIr5y0qyb51SeYWFVvQJP5FUivyzS2fRM?clckid=c487e7dc";

const webinar = {
  source: "https://cdnv.boomstream.com/balancer/wl0fWsUN-EuQeQgfF.mp4",
  poster: `${basePath}images/tild3137-3330-4364-b639-393637636430___2.jpg`,
};

const webinarTitleLines = [
  "8 секретов успешной",
  "свадьбы в Москве,",
  "о которых вам",
  "не расскажут",
  "организаторы",
];

const benefits = [
  "Сколько реально стоит свадьба и где бюджет чаще всего уезжает незаметно.",
  "Как экономить без ощущения, что вы режете качество вечера.",
  "В каком порядке принимать решения, чтобы не переделывать подготовку несколько раз.",
  "Какие ошибки на старте потом ломают тайминг, атмосферу и спокойствие пары.",
];

const shortVideos = [
  {
    title: "Почему свадьба превращается в хаос",
    source: "https://cdnv.boomstream.com/balancer/pCq9x3Jn-SxJPiQup.mp4",
    poster: `${basePath}images/tild3932-3931-4735-a161-326538646532__frame_23_4.jpg`,
  },
  {
    title: "Как не перегрузить вечер тостами",
    source: "https://cdnv.boomstream.com/balancer/rSg5jRyU-SxJPiQup.mp4",
    poster: `${basePath}images/tild3830-3066-4262-b839-303266343163__frame_24_3.jpg`,
  },
  {
    title: "Что важно обсудить с площадкой",
    source: "https://cdnv.boomstream.com/balancer/r9seULNi-SxJPiQup.mp4",
    poster: `${basePath}images/tild3031-3935-4233-a233-343364666435__frame_25_3.jpg`,
  },
  {
    title: "Как выбрать комфортный темп свадьбы",
    source: "https://cdnv.boomstream.com/balancer/RNUDagDY-SxJPiQup.mp4",
    poster: `${basePath}images/tild6238-3761-4433-b738-633932653234__group_49_1_1.jpg`,
  },
  {
    title: "Где гостям чаще всего становится неудобно",
    source: "https://cdnv.boomstream.com/balancer/ytQQEk4L-SxJPiQup.mp4",
    poster: `${basePath}images/tild6361-3931-4238-b430-313839383833__img_3595_1.jpg`,
  },
  {
    title: "Что делает ведущий до первого конкурса",
    source: "https://cdnv.boomstream.com/balancer/y8riDaTB-SxJPiQup.mp4",
    poster: `${basePath}images/tild3265-6666-4432-a665-323731393064__x_a0d91dd1_1.jpg`,
  },
];

const contactLinks = [
  { label: "Telegram", href: telegramContactUrl },
  { label: "MAX", href: maxContactUrl },
];
---

<BaseLayout
  title="Полезные материалы подготовки к свадьбе | Тимур Громов"
  description="Авторский вебинар и короткие видео Тимура Громова о подготовке к свадьбе, бюджете, тайминге и ошибках, которые лучше предусмотреть заранее."
  canonical={pageUrl}
  ogImage={socialImageUrl}
  ogImageAlt="Тимур Громов и свадебная пара"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://cdnv.boomstream.com" crossorigin />
  </Fragment>

  <main class="materials-page">
    <header class="materials-header">
      <a class="materials-brand" href={basePath} aria-label="На главную timurgromov.ru">
        <span>Свадебный ведущий</span>
        <strong>Тимур Громов</strong>
      </a>
      <nav class="materials-nav" aria-label="Навигация по материалам">
        <a href="#webinar">Вебинар</a>
        <a href="#short-videos">Короткие видео</a>
        <a href="#contacts">Материалы</a>
      </nav>
    </header>

    <section class="materials-hero" id="webinar">
      <div class="materials-shell materials-hero__shell">
        <div class="materials-hero__copy">
          <p class="materials-kicker">Авторский вебинар</p>
          <h1>
            {webinarTitleLines.map((line) => <span>{line}</span>)}
          </h1>
          <p class="materials-hero__lead">
            Спокойный разбор подготовки к свадьбе: где чаще всего возникают
            ошибки, как не потерять бюджет и в каком порядке принимать решения.
          </p>
        </div>

        <div class="materials-hero__layout">
          <div class="materials-webinar">
            <video
              class="materials-webinar__video"
              controls
              playsinline
              preload="metadata"
              poster={webinar.poster}
            >
              <source src={webinar.source} type="video/mp4" />
              Ваш браузер не поддерживает встроенное видео. Откройте материал в
              современном браузере или напишите мне в Telegram.
            </video>
          </div>

          <aside class="materials-benefits" aria-label="Что вы узнаете на вебинаре">
            <p class="materials-benefits__label">Вы узнаете</p>
            <ul>
              {benefits.map((item) => <li>{item}</li>)}
            </ul>
            <div class="materials-contact-inline">
              <span>За дополнительными материалами</span>
              {contactLinks.map((link) => (
                <a href={link.href} target="_blank" rel="nofollow noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="materials-section materials-section--light">
      <div class="materials-shell materials-intro">
        <div>
          <p class="materials-kicker">После просмотра</p>
          <h2>Если хотите конспект и дополнительные материалы, напишите мне лично</h2>
        </div>
        <p>
          Эта страница оставляет старую вебинарную механику: вы смотрите разбор,
          понимаете, насколько тема вам актуальна, а затем пишете мне в удобный
          мессенджер. Я уточню пару вводных по вашей свадьбе и отправлю подходящие
          материалы.
        </p>
      </div>
    </section>

    <section class="materials-section" id="short-videos">
      <div class="materials-shell">
        <div class="materials-section__head">
          <p class="materials-kicker">Быстрые разборы</p>
          <h2>Короткие полезные видео</h2>
          <p>
            Небольшие ролики на отдельные темы подготовки. Они не заменяют
            вебинар, а помогают быстро подсветить частые ошибки.
          </p>
        </div>

        <div class="materials-video-grid">
          {shortVideos.map((video) => (
            <article class="materials-video-card">
              <video controls playsinline preload="none" poster={video.poster}>
                <source src={video.source} type="video/mp4" />
                Видео не поддерживается вашим браузером.
              </video>
              <h3>{video.title}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="materials-cta" id="contacts">
      <div class="materials-shell materials-cta__inner">
        <div>
          <p class="materials-kicker">Следующий шаг</p>
          <h2>Получить дополнительные материалы</h2>
          <p>
            Напишите, кто вы и когда планируется свадьба. Я отправлю конспект и
            полезные материалы, которые подходят под вашу ситуацию.
          </p>
        </div>
        <div class="materials-cta__links" aria-label="Связаться с Тимуром">
          {contactLinks.map((link) => (
            <a class="materials-button" href={link.href} target="_blank" rel="nofollow noreferrer">
              <span>{link.label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(html) {
    background: #fffefa;
  }

  :global(body) {
    background: #fffefa;
    color: #1c1b1a;
  }

  .materials-page {
    --materials-bg: #fffefa;
    --materials-ink: #1c1b1a;
    --materials-muted: rgba(28, 27, 26, 0.66);
    --materials-line: rgba(28, 27, 26, 0.14);
    --materials-accent: #fa4604;
    min-height: 100vh;
    width: 100%;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 8% 8%, rgba(250, 70, 4, 0.08), transparent 28rem),
      linear-gradient(180deg, #fffefa 0%, #fff8ec 48%, #fffefa 100%);
    color: var(--materials-ink);
    font-family: Manrope, Arial, Helvetica, sans-serif;
  }

  .materials-shell {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding-inline: clamp(20px, 4vw, 56px);
  }

  .materials-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 12px clamp(20px, 4vw, 56px);
    background: var(--materials-accent);
    color: #fffefa;
  }

  .materials-brand {
    display: inline-flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1;
    text-transform: uppercase;
  }

  .materials-brand span {
    font-size: 10px;
    opacity: 0.78;
  }

  .materials-brand strong,
  .materials-hero h1,
  .materials-section h2,
  .materials-cta h2 {
    font-family: Impact, "Arial Narrow", Arial, Helvetica, sans-serif;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .materials-brand strong {
    font-size: clamp(20px, 2.1vw, 32px);
  }

  .materials-nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 32px);
    font-size: 14px;
  }

  .materials-nav a {
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .materials-nav a:hover {
    border-color: currentColor;
    opacity: 0.75;
  }

  .materials-hero {
    padding: clamp(40px, 6vw, 76px) 0 clamp(48px, 7vw, 92px);
  }

  .materials-hero__shell {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
  }

  .materials-hero__copy {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(280px, 0.42fr);
    gap: 28px;
    align-items: end;
  }

  .materials-kicker {
    margin: 0 0 14px;
    color: var(--materials-accent);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    grid-column: 1 / -1;
  }

  .materials-hero h1 {
    margin: 0;
    min-width: 0;
    max-width: 760px;
    font-size: clamp(42px, 4.9vw, 70px);
    line-height: 0.94;
  }

  .materials-hero h1 span {
    display: block;
  }

  .materials-hero__lead {
    margin: 0;
    color: var(--materials-muted);
    font-size: clamp(17px, 1.6vw, 22px);
    line-height: 1.35;
  }

  .materials-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.38fr) minmax(300px, 0.62fr);
    gap: clamp(18px, 2vw, 28px);
    align-items: stretch;
  }

  .materials-webinar,
  .materials-benefits,
  .materials-video-card,
  .materials-cta {
    border: 1px solid var(--materials-line);
  }

  .materials-webinar {
    overflow: hidden;
    border-radius: 10px;
    background: #111;
    box-shadow: 0 28px 70px rgba(28, 27, 26, 0.16);
  }

  .materials-webinar__video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #111;
  }

  .materials-benefits {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: clamp(22px, 3vw, 34px);
    border-radius: 10px;
    background: rgba(255, 254, 250, 0.74);
    backdrop-filter: blur(18px);
  }

  .materials-benefits__label {
    margin: 0;
    font-family: Impact, "Arial Narrow", Arial, Helvetica, sans-serif;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .materials-benefits ul {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .materials-benefits li {
    position: relative;
    padding-left: 28px;
    color: var(--materials-muted);
    font-size: 16px;
    line-height: 1.35;
  }

  .materials-benefits li::before {
    content: "";
    position: absolute;
    top: 0.48em;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--materials-accent);
  }

  .materials-contact-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    align-items: center;
    color: var(--materials-muted);
    font-size: 14px;
  }

  .materials-contact-inline a {
    color: var(--materials-accent);
    font-weight: 700;
    border-bottom: 1px solid currentColor;
  }

  .materials-section {
    padding: clamp(58px, 8vw, 112px) 0;
    background: #fffefa;
  }

  .materials-section--light {
    border-block: 1px solid var(--materials-line);
    background: #1c1b1a;
    color: #fffefa;
  }

  .materials-section--light .materials-kicker {
    color: #fa4604;
  }

  .materials-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.75fr);
    gap: clamp(28px, 6vw, 96px);
    align-items: start;
  }

  .materials-section h2,
  .materials-cta h2 {
    margin: 0;
    font-size: clamp(42px, 6vw, 90px);
    line-height: 0.92;
  }

  .materials-intro p,
  .materials-section__head p,
  .materials-cta p {
    margin: 0;
    color: currentColor;
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.45;
    opacity: 0.74;
  }

  .materials-section__head {
    display: grid;
    max-width: 900px;
    gap: 18px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .materials-video-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .materials-video-card {
    overflow: hidden;
    border-radius: 10px;
    background: rgba(28, 27, 26, 0.04);
  }

  .materials-video-card video {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #111;
    object-fit: cover;
  }

  .materials-video-card h3 {
    margin: 0;
    padding: 18px;
    font-size: 18px;
    line-height: 1.15;
  }

  .materials-cta {
    margin: 0 clamp(20px, 4vw, 56px) clamp(36px, 5vw, 72px);
    border-radius: 10px;
    background: var(--materials-accent);
    color: #fffefa;
  }

  .materials-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    padding-block: clamp(36px, 6vw, 76px);
  }

  .materials-cta .materials-kicker,
  .materials-cta p {
    color: #fffefa;
  }

  .materials-cta p {
    max-width: 640px;
    margin-top: 22px;
  }

  .materials-cta__links {
    display: grid;
    gap: 12px;
  }

  .materials-button {
    display: grid;
    min-height: 58px;
    grid-template-columns: minmax(0, 1fr) 58px;
    align-items: stretch;
    color: #1c1b1a;
    font-weight: 700;
  }

  .materials-button span {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fffefa;
  }

  .materials-button span:first-child {
    justify-content: flex-start;
    padding: 0 20px;
    border-radius: 6px;
  }

  .materials-button span:last-child {
    margin-left: -1px;
    border-radius: 6px;
    transition: transform 0.2s ease;
  }

  .materials-button:hover span:last-child {
    transform: rotate(12deg);
  }

  @media (max-width: 1040px) {
    .materials-hero__copy,
    .materials-hero__layout,
    .materials-intro,
    .materials-cta__inner {
      grid-template-columns: 1fr;
    }

    .materials-video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .materials-hero h1 {
      max-width: 100%;
    }
  }

  @media (max-width: 680px) {
    .materials-page,
    .materials-shell,
    .materials-hero__copy,
    .materials-hero__layout,
    .materials-intro,
    .materials-video-grid,
    .materials-cta__inner {
      width: 100%;
      max-width: 100vw;
      min-width: 0;
    }

    .materials-webinar,
    .materials-benefits,
    .materials-video-card {
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }

    .materials-webinar__video,
    .materials-video-card video {
      width: 100%;
      max-width: 100%;
    }

    .materials-header {
      position: relative;
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .materials-nav {
      width: 100%;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 10px 18px;
      font-size: 11px;
    }

    .materials-hero {
      padding-top: 32px;
    }

    .materials-hero h1 {
      max-width: calc(100vw - 40px);
      font-size: clamp(30px, 8.4vw, 36px);
      line-height: 0.96;
      overflow-wrap: anywhere;
    }

    .materials-hero__lead {
      max-width: calc(100vw - 40px);
      font-size: 16px;
      overflow-wrap: anywhere;
    }

    .materials-section h2,
    .materials-cta h2 {
      max-width: calc(100vw - 40px);
      font-size: clamp(30px, 8.4vw, 36px);
      line-height: 0.96;
    }

    .materials-intro p,
    .materials-section__head p,
    .materials-cta p {
      max-width: calc(100vw - 40px);
    }

    .materials-benefits li {
      max-width: calc(100vw - 112px);
    }

    .materials-benefits li,
    .materials-intro p,
    .materials-section__head p,
    .materials-cta p {
      overflow-wrap: anywhere;
    }

    .materials-benefits {
      padding: 20px;
    }

    .materials-contact-inline {
      align-items: flex-start;
      flex-direction: column;
    }

    .materials-video-grid {
      grid-template-columns: 1fr;
    }

    .materials-video-card video {
      aspect-ratio: 4 / 5;
    }

    .materials-cta {
      margin-inline: 16px;
    }

    .materials-cta__inner {
      padding-inline: 16px;
    }
  }
</style>
