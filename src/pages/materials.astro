    .concat(
      `<script>
        (function() {
          function syncMaterialsHeader() {
            const isMobile = window.matchMedia("(max-width: 639px)").matches;
            const root = document.documentElement;
            const currentY = window.scrollY || 0;
            const previousY = Number(root.dataset.materialsHeaderY || "0");

            if (!isMobile) {
              root.classList.remove("materials-header-hidden");
              root.dataset.materialsHeaderY = String(currentY);
              return;
            }

            if (currentY <= 12 || currentY < previousY - 6) {
              root.classList.remove("materials-header-hidden");
            } else if (currentY > previousY + 6) {
              root.classList.add("materials-header-hidden");
            }

            root.dataset.materialsHeaderY = String(currentY);
          }

          window.addEventListener("scroll", syncMaterialsHeader, { passive: true });
          window.addEventListener("resize", syncMaterialsHeader);
          window.addEventListener("pageshow", syncMaterialsHeader);
          document.addEventListener("DOMContentLoaded", syncMaterialsHeader);
        })();
      </script>`,
    )
    .concat(
      `<script>
        (function() {
          const advicePopupSelector = '.t1093 .t-popup[data-tooltip-hook^="#popup:video-soveti-"]';

          function playAdvicePopupVideo(attemptsLeft) {
            const popup = document.querySelector(advicePopupSelector + '.t-popup_show');

            if (!popup) {
              return;
            }

            const video = popup.querySelector("video");

            if (video) {
              const playResult = video.play();

              if (playResult && typeof playResult.catch === "function") {
                playResult.catch(function() {
                  return;
                });
              }

              return;
            }

            if (attemptsLeft > 0) {
              window.setTimeout(function() {
                playAdvicePopupVideo(attemptsLeft - 1);
              }, 120);
            }
          }

          document.body.addEventListener("popupShowed", function() {
            playAdvicePopupVideo(12);
          });
        })();
      </script>`,
    )
    .concat(
      `<script>
        (function() {
          const webinarVideos = [
            { recordId: "rec861962232", elementId: "1739078296052" },
            { recordId: "rec862050095", elementId: "1739078914882" },
          ];

          function getShape(item) {
            return document.querySelector(
              "#" + item.recordId + ' .tn-elem[data-elem-id="' + item.elementId + '"]',
            );
          }

          function getVideo(shape) {
            return shape ? shape.querySelector(".tn-atom__videoiframe video") : null;
          }

          function syncState(shape) {
            const video = getVideo(shape);
            const isReady = Boolean(
              video && video.readyState >= 2 && video.videoWidth > 0 && video.videoHeight > 0,
            );
            const isPlaying = Boolean(video && isReady && !video.paused && !video.ended);

            shape.classList.toggle("tg-webinar-video-ready", isReady);
            shape.classList.toggle("tg-webinar-video-playing", isPlaying);
            shape.classList.toggle("tg-webinar-video-paused", Boolean(video && !isPlaying));
          }

          function playVideo(video) {
            video.preload = "auto";
            video.load();

            const playResult = video.play();

            if (playResult && typeof playResult.catch === "function") {
              playResult.catch(function() {
                return;
              });
            }
          }

          function bindVideo(shape) {
            const video = getVideo(shape);

            if (!video) {
              syncState(shape);
              return;
            }

            if (video.dataset.materialsWebinarStateBound !== "true") {
              video.dataset.materialsWebinarStateBound = "true";
              video.controls = false;
              video.removeAttribute("controls");
              video.style.pointerEvents = "none";

              ["loadstart", "loadedmetadata", "loadeddata", "canplay", "play", "playing", "timeupdate", "pause", "ended", "error", "stalled", "waiting"].forEach(function(eventName) {
                video.addEventListener(eventName, function() {
                  syncState(shape);
                });
              });

              [80, 250, 700, 1300].forEach(function(delay) {
                window.setTimeout(function() {
                  syncState(shape);
                }, delay);
              });
            }

            syncState(shape);
          }

          function toggleVideo(shape) {
            const video = getVideo(shape);

            if (!video) {
              return false;
            }

            if (video.paused || video.ended) {
              playVideo(video);
              [80, 250, 700, 1300, 2500].forEach(function(delay) {
                window.setTimeout(function() {
                  syncState(shape);
                }, delay);
              });
            } else {
              video.pause();
            }

            syncState(shape);
            return true;
          }

          function bindShape(shape) {
            const atom = shape.querySelector(".tn-atom");

            if (!atom || shape.dataset.materialsWebinarToggleBound === "true") {
              return;
            }

            shape.dataset.materialsWebinarToggleBound = "true";

            shape.addEventListener(
              "click",
              function(event) {
                if (!toggleVideo(shape)) {
                  window.setTimeout(function() {
                    bindVideo(shape);
                  }, 0);
                  window.setTimeout(function() {
                    bindVideo(shape);
                  }, 160);
                  return;
                }

                event.preventDefault();
                event.stopPropagation();

                if (event.stopImmediatePropagation) {
                  event.stopImmediatePropagation();
                }
              },
              true,
            );

            const observer = new MutationObserver(function() {
              bindVideo(shape);
            });

            observer.observe(shape, { childList: true, subtree: true });
            bindVideo(shape);
          }

          function initWebinarVideoToggles() {
            webinarVideos.forEach(function(item) {
              const shape = getShape(item);

              if (shape) {
                bindShape(shape);
              }
            });
          }

          document.addEventListener("DOMContentLoaded", initWebinarVideoToggles);
          window.addEventListener("load", initWebinarVideoToggles);
          window.setTimeout(initWebinarVideoToggles, 500);
          window.setTimeout(initWebinarVideoToggles, 1500);
        })();
      </script>`,
    )
