function extractTildaRecord(html: string, recordId: string) {
  const startMarker = `<div id="${recordId}"`;
  const startIndex = html.indexOf(startMarker);

  if (startIndex === -1) {
    throw new Error(`Не найдена Tilda-запись ${recordId}`);
  }

  const nextRecordIndex = html.indexOf(' <div id="rec', startIndex + startMarker.length);
  const endIndex = nextRecordIndex === -1 ? html.length : nextRecordIndex;

  return html.slice(startIndex, endIndex);
}

function injectBeforeTildaRecordScript(
  html: string,
  recordNumericId: string,
  markup: string,
) {
  const marker =
    `</div> </div> <scr` +
    `ipt>t_onFuncLoad('t396_initialScale',function() {t396_initialScale('${recordNumericId}');});`;

  if (!html.includes(marker)) {
    return html;
  }

  return html.replace(marker, `${markup}${marker}`);
}

function withBasePath(html: string) {
  return html
    .replace(/href=(['"])(?!https?:|mailto:|tel:|#|\/{2})(\/?)(?!\/)/g, `href=$1${basePath}`)
    .replace(/src=(['"])(?!https?:|data:|\/{2})(\/?)(?!\/)/g, `src=$1${basePath}`)
    .replace(/action=(['"])(?!https?:|mailto:|tel:|#|\/{2})(\/?)(?!\/)/g, `action=$1${basePath}`)
    .replace(/content=(['"])images\//g, `content=$1${basePath}images/`)
    .replace(/data-original=(['"])(?!https?:|data:|\/{2})(\/?)(?!\/)/g, `data-original=$1${basePath}`)
    .replace(/&quot;images\//g, `&quot;${basePath}images/`)
    .replace(
      /url\((['"]?)(?!https?:|data:|\/{2})(\/?)(?!\/)/g,
      (_match, quote: string) => `url(${quote}${basePath}`,
    );
}

function patchMobileWebinarBadgeTriggers(
  recordHtml: string,
  triggerOffsets: Record<string, string>,
) {
  return Object.entries(triggerOffsets).reduce((html, [elementId, triggerOffset]) => {
    const elementPattern = new RegExp(
      `(<div\\b[^>]*data-elem-id=(["'])${elementId}\\2[^>]*?)\\sdata-animate-fix-trgofst-res-320=(["'])[^"']*\\3`,
      "g",
    );

    return html.replace(
      elementPattern,
      `$1 data-animate-fix-trgofst-res-320="${
        triggerOffset
      }"`,
    );
  }, recordHtml);
}

function patchMobileWebinarCardTriggers(
  recordHtml: string,
  triggerOffsets: Record<string, string>,
) {
  return Object.entries(triggerOffsets).reduce((html, [groupId, triggerOffset]) => {
    const groupPattern = new RegExp(
      `(<div\\b[^>]*data-group-id=(["'])${groupId}\\2[^>]*?)\\sdata-animate-sbs-trgofst-res-320=(["'])[^"']*\\3`,
      "g",
    );

    return html.replace(
      groupPattern,
      `$1 data-animate-sbs-trgofst-res-320="${triggerOffset}"`,
    );
  }, recordHtml);
}

function stripWebinarAnimations(recordHtml: string) {
  return recordHtml
    .replace(/\sdata-animate-[^=]+=(["']).*?\1/g, "")
    .replace(/\bt-animate\b/g, "")
    .replace(/\bt396__elem--anim-hidden\b/g, "")
    .replace(/\s{2,}/g, " ");
}

function patchWebinarArtboardHeights(
  recordHtml: string,
  heights: {
    default: number;
    res1200: number;
    res640: number;
    res320: number;
  },
) {
  const recordId = recordHtml.match(/id="(rec\d+)"/)?.[1];

  if (!recordId) {
    return recordHtml;
  }

  let mediaIndex = 0;
  const mediaHeights = [heights.res1200, heights.res640, heights.res320];

  return recordHtml
    .replace(/\bdata-artboard-height="[^"]*"/, `data-artboard-height="${heights.default}"`)
    .replace(
      /\bdata-artboard-height-res-1200="[^"]*"/,
      `data-artboard-height-res-1200="${heights.res1200}"`,
    )
    .replace(
      /\bdata-artboard-height-res-640="[^"]*"/,
      `data-artboard-height-res-640="${heights.res640}"`,
    )
    .replace(
      /\bdata-artboard-height-res-320="[^"]*"/,
      `data-artboard-height-res-320="${heights.res320}"`,
    )
    .replace(
      new RegExp(`(#${recordId} \\.t396__artboard \\{height:)\\d+(px;)`),
      `$1${heights.default}$2`,
    )
    .replace(
      new RegExp(`(#${recordId} \\.t396__filter \\{height:)\\d+(px;)`),
      `$1${heights.default}$2`,
    )
    .replace(
      new RegExp(`(#${recordId} \\.t396__carrier\\{height:)\\d+(px;)`),
      `$1${heights.default}$2`,
    )
    .replace(
      new RegExp(
        `(#${recordId} \\.t396__artboard,#${recordId} \\.t396__filter,#${recordId} \\.t396__carrier \\{height:)\\d+(px;\\})`,
        "g",
      ),
      (match, prefix, suffix) => {
        const nextHeight = mediaHeights[mediaIndex] ?? mediaHeights[mediaHeights.length - 1];
        mediaIndex += 1;

        return `${prefix}${nextHeight}${suffix}`;
      },
    );
}

function findDivElementBounds(html: string, openTagStart: number) {
  const divTagPattern = /<\/?div\b[^>]*>/gi;
  divTagPattern.lastIndex = openTagStart;
  let depth = 0;
  let match: RegExpExecArray | null;

  while ((match = divTagPattern.exec(html))) {
    const tag = match[0];
    depth += tag.startsWith("</") ? -1 : 1;

    if (depth === 0) {
      return {
        start: openTagStart,
        end: divTagPattern.lastIndex,
      };
    }
  }

  return null;
}

function extractGroupElement(html: string, groupId: string) {
  const groupOpenPattern = new RegExp(
    `<div\\b[^>]*\\bdata-group-id=(["'])${groupId}\\1[^>]*>`,
  );
  const groupMatch = html.match(groupOpenPattern);

  if (!groupMatch || groupMatch.index === undefined) {
    return null;
  }

  const bounds = findDivElementBounds(html, groupMatch.index);

  if (!bounds) {
    return null;
  }

  return {
    markup: html.slice(bounds.start, bounds.end),
    start: bounds.start,
    end: bounds.end,
  };
}

function wrapMobileWebinarCardStrip(recordHtml: string, groupIds: string[]) {
  let html = recordHtml;
  const groupMarkup: string[] = [];

  groupIds.forEach((groupId) => {
    const group = extractGroupElement(html, groupId);

    if (!group) {
      return;
    }

    groupMarkup.push(group.markup);
    html = `${html.slice(0, group.start)}${html.slice(group.end)}`;
  });

  if (groupMarkup.length !== groupIds.length) {
    return recordHtml;
  }

  return injectBeforeTildaRecordScript(
    html,
    mobileWebinarRecordId.replace("rec", ""),
    ` <div class="tg-mobile-card-strip" aria-label="Карточки вебинара">${groupMarkup.join(" ")}</div>`,
  );
}

function enablePopupVideoAutoplay(recordHtml: string) {
  return recordHtml.replace(
    /data-elem-type='video'/,
    `data-elem-type='video' data-field-autoplay-value="y" data-field-mute-value="y"`,
  );
}

